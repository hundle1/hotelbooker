@model IEnumerable<HotelBooker.Models.Room>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>


    <div style="width: 100%; margin-bottom: 10px;">
        <a  style="margin-left: 92%; color: white; text-decoration: none;"  class="btn btn-success" asp-action="Create">Create New</a>
    </div>

<table class="table">
    <thead>
        <tr align="center">
            <th>
                @Html.DisplayNameFor(model => model.RoomName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Services)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RoomImage)
            </th>
            <th>
                Action
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr align="center">
            <td>
                @Html.DisplayFor(modelItem => item.RoomName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReleaseDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Services)
            </td>
            <td>
                USD @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                <img src="@Url.Content("~/img/" + item.RoomImage)" alt="@item.RoomName" style="width:100px; height:auto;" />
            </td>
            <td>
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="btn btn-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
