@model HotelBooker.Models.Hotel

@{
    ViewData["Title"] = "Booking - " + Model.HotelName;
}
<div style="background-color: black; width: 100%; height: 150px;"></div>
<div class="container-xl" style="padding-top: 50px; display: flex; gap: 20px; display:flex; flex-direction: column;">
    <h2>@Model.HotelName - Room: @ViewBag.RoomNumber</h2>
    <p><strong>Location:</strong> @Model.HotelLocation</p>
    <p><strong>Rating:</strong> @Model.HotelRate &#9733;</p>
    @if (Model.User != null)
    {
        <p><strong>User:</strong> @Model.User.UserName</p>
    }
    <form method="post" asp-action="Complete">
        <input type="hidden" name="hotelId" value="@Model.Id" />
        <input type="hidden" name="roomNumber" value="@ViewBag.RoomNumber" />
        <div class="form-group">
            <label for="checkInDate">Check-in Date:</label>
            <input type="date" id="checkInDate" name="checkInDate" class="form-control" required />
        </div>
        <div class="form-group">
            <label for="checkOutDate">Check-out Date:</label>
            <input type="date" id="checkOutDate" name="checkOutDate" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Complete Booking</button>
    </form>
</div>
