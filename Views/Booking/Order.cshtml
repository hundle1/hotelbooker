@model HotelBooker.Models.Order

@{
    ViewData["Title"] = "Order Confirmation";
}
<div style="background-color: black; width: 100%; height: 150px; display: flex; align-items: center; justify-content: center; margin-bottom: 50px;"></div>
<div class="container-xl" style="padding: 0px 50px 50px 50px; display: flex; gap: 20px; flex-direction: column; max-width: 800px; margin: auto; background-color: #f9f9f9; border-radius: 8px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);">
    <h2 style="color: #333; font-weight: bold; text-align: center; margin-bottom: 30px;">Booking Details</h2>

    <div style="display: flex; flex-direction: column; gap: 20px;">
        <!-- Hotel Name -->
        <p style="font-size: 18px; color: #555;">
            <strong>Hotel:</strong> 
            <span style="color: #007bff;">@(Model.Hotel?.HotelName ?? "N/A")</span>
        </p>

        <!-- Room Number -->
        <p style="font-size: 18px; color: #555;">
            <strong>Room Number:</strong> 
            <span style="color: #007bff;">@Model.RoomNumber</span>
        </p>

        <!-- Location -->
        <p style="font-size: 18px; color: #555;">
            <strong>Location:</strong> 
            <span style="color: #007bff;">@(Model.Hotel?.HotelLocation ?? "N/A")</span>
        </p>

        <!-- Check-in Date -->
        <p style="font-size: 18px; color: #555;">
            <strong>Check-in Date:</strong> 
            <span style="color: #007bff;">@Model.CheckInDate.ToString("MM/dd/yyyy")</span>
        </p>

        <!-- Check-out Date -->
        <p style="font-size: 18px; color: #555;">
            <strong>Check-out Date:</strong> 
            <span style="color: #007bff;">@Model.CheckOutDate.ToString("MM/dd/yyyy")</span>
        </p>

        <!-- Total Price -->
        <p style="font-size: 18px; color: #555;">
            <strong>Total Price:</strong> 
            <span style="font-weight: bold; color: #28a745;">$@Model.TotalPrice</span>
        </p>

        <!-- User -->
        <p style="font-size: 18px; color: #555;">
            <strong>User:</strong> 
            <span style="color: #007bff;">@(Model.User?.UserName ?? "N/A")</span>
        </p>
    </div>

    <!-- Go to Home Button -->
    <div style="margin-top: 30px; text-align: center;">
        <a href="@Url.Action("Index", "Home")" 
           class="btn btn-success" 
           style="padding: 12px 24px; font-size: 18px; font-weight: bold; background-color: #28a745; border: none; border-radius: 4px; text-decoration: none; color: white;">
            Go to Home
        </a>
    </div>
</div>
