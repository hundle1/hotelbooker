@model HotelBooker.Models.Order

@{
    ViewData["Title"] = "Order Confirmation";
}
<div style="background-color: black; width: 100%; height: 150px;"></div>
<div class="container-xl" style="padding-top: 50px; display: flex; gap: 20px; display:flex; flex-direction: column;">
    <h2>Order Confirmation</h2>
    <h4>Booking Details</h4>
    <p><strong>Hotel:</strong> @(Model.Hotel?.HotelName ?? "N/A")</p>
    <p><strong>Room Number:</strong> @Model.RoomNumber</p>
    <p><strong>Location:</strong> @(Model.Hotel?.HotelLocation ?? "N/A")</p>
    <p><strong>Check-in Date:</strong> @Model.CheckInDate.ToString("MM/dd/yyyy")</p>
    <p><strong>Check-out Date:</strong> @Model.CheckOutDate.ToString("MM/dd/yyyy")</p>
    <p><strong>Total Price:</strong> $@Model.TotalPrice</p>
    <p><strong>User:</strong> @(Model.User?.UserName ?? "N/A")</p>
    <a href="@Url.Action("Index", "Home")" class="btn btn-success">Go to Home</a>
</div>
