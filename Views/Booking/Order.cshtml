@model HotelBooker.Models.Order

@{
    ViewData["Title"] = "Order Confirmation";
}
<div style="background-color: black; width: 100%; height: 150px; display: flex; align-items: center; justify-content: center; margin-bottom: 50px;"></div>
<div style="display: flex; justify-content: center; margin-bottom: 30px;">
    <div style="background-color: black; width: 100%; max-width: 800px; height: 70px; display: flex; align-items: center; justify-content: center; border-radius: 10px;">
        <h1 style="color: white; font-size: 24px;">Hotel Booker Receipt</h1>
    </div>
</div>
<div class="container-xl" style="padding: 20px; display: flex; flex-direction: column; gap: 20px; max-width: 800px; margin: auto; background: #ffffff; border-radius: 10px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); font-family: Arial, sans-serif;">
    <div style="border-bottom: 2px dashed #ddd; padding-bottom: 15px;">
        <p style="margin: 0; font-size: 18px;"><strong>Hotel:</strong> <span style="color: #007bff;">@(Model.Hotel?.HotelName ?? "N/A")</span></p>
        <p style="margin: 0; font-size: 18px;"><strong>Location:</strong> <span style="color: #007bff;">@(Model.Hotel?.HotelLocation ?? "N/A")</span></p>
    </div>

    <div style="border-bottom: 2px dashed #ddd; padding-bottom: 15px;">
        <p style="margin: 0; font-size: 18px;"><strong>Room Number:</strong> <span style="color: #007bff;">@Model.RoomNumber</span></p>
        <p style="margin: 0; font-size: 18px;"><strong>Check-in Date:</strong> <span style="color: #007bff;">@Model.CheckInDate.ToString("MM/dd/yyyy")</span></p>
        <p style="margin: 0; font-size: 18px;"><strong>Check-out Date:</strong> <span style="color: #007bff;">@Model.CheckOutDate.ToString("MM/dd/yyyy")</span></p>
    </div>

    <div style="border-bottom: 2px dashed #ddd; padding-bottom: 15px;">
        <p style="margin: 0; font-size: 18px;"><strong>User:</strong> <span style="color: #007bff;">@(Model.User?.UserName ?? "N/A")</span></p>
        <p style="margin: 0; font-size: 18px;"><strong>Email:</strong> <span style="color: #007bff;">@(Model.User?.Email ?? "N/A")</span></p>
    </div>

    <div style="border-bottom: 2px dashed #ddd; padding-bottom: 15px;">
        <p style="margin: 0; font-size: 20px; font-weight: bold;"><strong>Total Price:</strong> <span style="color: #28a745;">$@Model.TotalPrice.ToString("F2")</span></p>
    </div>

    <!-- Barcode Section -->
    <div style="text-align: center; margin-top: 20px;">
        <p style="font-size: 18px; font-weight: bold; color: #333;">Booking Code</p>
        <svg id="barcode"></svg>
    </div>

    <!-- Go to Home Button -->
    <div style="margin-top: 10px; text-align: center;">
        <a href="@Url.Action("Index", "Home")" class="btn btn-success" style="padding: 12px 24px; font-size: 18px; font-weight: bold; background-color: #28a745; border: none; border-radius: 4px; text-decoration: none; color: white;">
            Go to Home
        </a>
    </div>
</div>

<!-- JsBarcode Library -->
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.0/dist/JsBarcode.all.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const orderId = "@Model.Id";
        const userId = "@Model.User?.Id";
        @* const hotel = "@Model.Hotel?.HotelName ?? "N/A")"; *@
        const uniqueCode = "HT" + btoa(orderId + userId).substring(0, 6).toUpperCase();
        JsBarcode("#barcode", uniqueCode, {
            format: "CODE128",
            lineColor: "#000",
            width: 2,
            height: 50,
            displayValue: true
        });
    });
</script>
