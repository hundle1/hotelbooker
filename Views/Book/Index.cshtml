@model IEnumerable<HotelBooker.Models.Room>

@{
    ViewData["Title"] = "Index";
}


<div class="container" style="padding-top: 100px;">
    <h1>Hiển thị danh sách phòng và chức năng book phòng</h1>
    <p>@Html.DisplayNameFor(model => model.RoomName)</p>
    @foreach (var item in Model) {
                <div>
                    @Html.DisplayFor(modelItem => item.RoomName)
                </div>
                }
</div>