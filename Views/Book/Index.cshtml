@model IEnumerable<HotelBooker.Models.Room>

@{
    ViewData["Title"] = "Booking";
}
<div style="background-color: black; width: 100%; height: 150px;"></div>
<div class="container-xxl" style="padding-top: 50px; display: flex; gap: 20px;">
    <div style="width: 20%; border-right: 1px solid #ccc; padding-right: 20px;">
        <h3>Lọc</h3>
        <form method="get" asp-action="Index" asp-controller="Book">
            <div class="form-group">
                <label for="priceRange">Khoảng giá</label>
                <select id="priceRange" name="PriceRange" class="form-control">
                    <option value="">-- TẤT CẢ --</option>
                    <option value="1">0 - 500 USD</option>
                    <option value="2">500 - 1000 USD</option>
                    <option value="3">Trên 1000 USD</option>
                </select>
            </div>
            <div class="form-group">
                <label for="availability">Trạng thái</label>
                <select id="availability" name="Status" class="form-control">
                    <option value="">-- TẤT CẢ --</option>
                    <option value="true">Còn trống</option>
                    <option value="false">Đã thuê</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Lọc ngay</button>
        </form>
    </div>
    <div style="width: 80%;">
        <h1>Danh sách phòng</h1>
        <form method="get" asp-action="Index" asp-controller="Book" style="margin-bottom: 20px;">
            <div class="input-group">
                <input type="search" name="SearchString" value="@ViewData["CurrentFilter"]" placeholder="Tìm phòng..."
                    class="form-control" />
                <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            </div>
        </form>
        <div class="row">
            @foreach (var room in Model)
            {
                <div class="col-md-4 mb-4">
                    <a href="/Book/Detail/@room.Id" class="card item-hov text-decoration-none text-dark"
                        style="width: 100%; height: 550px; display: block;">
                        <img src="@Url.Content("~/img/" + room.RoomImage)" class="card-img-top" alt="@room.RoomName"
                            style="height: 200px; object-fit: cover;">
                        <div class="card-body">
                            <h5 align="center" style="padding-top: 10px;">Trạng thái: @(room.Status ? "Đã thuê" : "Còn trống")</h5>
                            <h4 class="card-title" style="font-family: sans-serif;">@room.RoomName</h4>
                            Giá: @room.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))<br />
                            Danh mục: @room.Services<br />
                            <p class="card-text">
                                <div class="furniture-list">
                                    @if (!string.IsNullOrEmpty(room.Furniture))
                                    {
                                        @foreach (var furniture in room.Furniture.Split(','))
                                        {
                                            <div class="furniture-item" style="font-family: sans-serif;">@furniture</div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="furniture-item" style="font-family: sans-serif; color: gray;">Không có nội thất</div>
                                    }
                                </div>
                            </p>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
