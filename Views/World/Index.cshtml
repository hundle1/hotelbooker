@{
    ViewData["Title"] = "World Map"; 
}
<div style="background-color: black; width: 100%; height: 150px;"></div>
<div class="container" style="padding-top: 150px; display: flex; gap: 20px; padding-top:50px; display:flex; flex-direction:column;">
    <h1>@ViewData["Title"]</h1>
    <div>
        Map of the world
        Choose location
        <span>
            <h1></h1>
            <div class="mini-infor">
                <div class="mini-infor__container">
                    <div class="mini-infor__container--img">
                        <img src="" alt="" />
                    </div>
                    <div class="mini-infor__container--content">
                        <h3></h3>
                        <p>Price: $100</p>
                        <p>Discount: 10%</p>
                        <p>Location: 123, ABC, XYZ</p>
                        <p>Rating: 5</p>
                    </div>
                </div>
            </div>
        </span>
    </div>
</div>