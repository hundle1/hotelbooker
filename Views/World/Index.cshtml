@model IEnumerable<HotelBooker.Models.Hotel>

@{
    ViewData["Title"] = "World Map";
}

<div style="background-color: black; width: 100%; height: 150px;"></div>
<div class="container-fluid" style="padding-top: 80px; padding-left: 80px; padding-right: 100px; display: flex; gap: 20px;">
    <div style="width: 80%; margin-right: 60px;">
        <div style="width: 100%; height: 650px;">
            <img src="@Url.Content("~/img/worldmap-bw.png")" alt="" style="width: 100%; height: auto;">
            <div>
                <div class="map-marker-Asia" style="display: inline; width: auto;">
                    Asia (@ViewBag.ContinentHotelCount["Asia"])
                </div>
                <div class="map-marker-Europe" style="display: inline; width: auto;">
                    Europe (@ViewBag.ContinentHotelCount["Europe"])
                </div>
                <div class="map-marker-Africa" style="display: inline; width: auto;">
                    Africa (@ViewBag.ContinentHotelCount["Africa"])
                </div>
                <div class="map-marker-America" style="display: inline; width: auto;">
                    America (@ViewBag.ContinentHotelCount["America"])
                </div>
                <div class="map-marker-Australia" style="display: inline; width: auto;">
                    Australia (@ViewBag.ContinentHotelCount["Australia"])
                </div>
            </div>
        </div>
        <div class="map-info">
            Map of the world - Choose a location by hovering over a continent.
        </div>
    </div>
    <div style="display: flex; flex-direction: column; gap: 10px; max-height: auto; overflow-y: auto; width: 20%; border-left: 1px solid gray; padding-left: 40px;">
        <h1>Hotels</h1>
        @foreach (var hotel in Model)
        {
            <div style="cursor: pointer; border: 1px solid gray; padding: 10px; display: flex; flex-direction: column; gap: 10px; width: 280px;">
                @if (!string.IsNullOrEmpty(hotel.HotelImage))
                {
                    <img src="@hotel.HotelImage" alt="@hotel.HotelName" style="width: auto; height: 100px; object-fit: cover;">
                }
                <div style="font-weight: bold; font-size: 14px;">
                    @hotel.HotelName
                </div>
                <div style="display: flex; gap: 47px; font-size: 12px; color: #555; width: auto; height: auto;">
                    <div>
                        <strong>Rating:</strong> @hotel.HotelRate / 5 <br/>
                        <strong>Rooms:</strong> @hotel.NumberOfRoom
                    </div>
                    <div>
                        <strong>Location:</strong> @hotel.HotelLocation
                    </div>
                </div>
            </div>
        }
    </div>
</div>
