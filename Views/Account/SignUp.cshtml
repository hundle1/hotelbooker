@model HotelBooker.Models.Account

@{
    ViewData["Title"] = "Sign Up";
}

<div style="background-color: black; width: 100%; height: 150px; display: flex; justify-content: center; align-items: center;">
</div>

<div class="container-xxl" style="padding-top: 50px; display: flex; gap: 20px; flex-direction: column; align-items: center;">
    <h2 class="text-center">Create Your Account</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="container" style="display: flex; gap: 20px; flex-direction: column;">
        <form asp-action="SignUp" method="post" class="w-50" style="max-width: 400px; background-color: #f8f9fa; border-radius: 8px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label">Name</label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" required />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label for="ConfirmPassword" class="form-label">Confirm Password</label>
                <input type="password" name="ConfirmPassword" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary w-100">Sign Up</button>
        </form>

        <div class="mt-3">
            Already have an account? <a href="/Account/Login">Login here</a>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
