@{
    ViewData["Title"] = "Login";
}

<div style="background-color: black; width: 100%; height: 150px; display: flex; justify-content: center; align-items: center;"></div>
<div class="container-xxl" style="padding-top: 50px; display: flex; gap: 20px; flex-direction: column; align-items: center;">
    <img src="@Url.Content("~/img/logo.webp")" alt="Travelix Logo" style="height: 80px; width: auto;" />

    <h2 class="text-center">Login to Travelix</h2>
    <form asp-action="Login" method="post" class="w-50" style="max-width: 400px; background-color: #f8f9fa; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
        <div class="form-group mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-control" required />
        </div>
        <div class="form-group mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" id="password" name="password" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary w-100">Login</button>
    </form>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-3">@ViewBag.Error</div>
    }

    <div class="mt-3">
        <p>Don't have an account? <a href="/Account/SignUp">Sign up</a></p>
    </div>
</div>

