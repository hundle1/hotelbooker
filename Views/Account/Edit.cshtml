@{
    Layout = "_Layout";
}

@using HotelBooker.Models
@model User

<div style="background-color: black; width: 100%; height: 150px;"></div>
<div class="container-xxl" style="padding-top: 50px; display: flex; gap: 20px; flex-direction: column;">
    <h2 class="text-center mb-4">Chỉnh sửa thông tin người dùng</h2>
    <form method="post" asp-action="Edit" enctype="multipart/form-data">
        <div class="row">
            <!-- Thông tin bên trái -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="UserName" class="form-label"><h4>User Name</h4></label>
                    <input type="text" class="form-control" id="UserName" name="UserName" value="@Model.UserName" required />
                </div>
                <div class="mb-3">
                    <label for="Email" class="form-label"><h4>Email</h4></label>
                    <input type="email" class="form-control" id="Email" name="Email" value="@Model.Email" required />
                </div>
                <div class="mb-3">
                    <label for="Phone" class="form-label"><h4>Phone number</h4></label>
                    <input type="text" class="form-control" id="Phone" name="Phone" value="@Model.Phone" />
                </div>
                <div class="mb-3">
                    <label for="Address" class="form-label"><h4>Address</h4></label>
                    <input type="text" class="form-control" id="Address" name="Address" value="@Model.Address" />
                </div>
                <div class="mb-3">
                    <label for="Birth">Birthdate</label>
                    <input type="date" class="form-control" id="Birth" name="Birth" value="@Model.Birth?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="mb-3">
                    <label for="Gender" class="form-label">Giới tính</label>
                    <select class="form-select" id="Gender" name="Gender">
                        <option value="Male" selected="@(Model.Gender == "Male" ? "selected" : null)">Male</option>
                        <option value="FeMale" selected="@(Model.Gender == "FeMale" ? "selected" : null)">FeMale</option>
                        <option value="Other" selected="@(Model.Gender == "Other" ? "selected" : null)">Other</option>
                    </select>
                </div>
                <div class="mb-3">
                    <input type="password" class="form-control" id="Password" name="Password" style="display: none;"/>
                </div>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>

            <!-- Ảnh đại diện bên phải -->
            <div class="col-md-6 text-center">
                <div class="mb-3" style="width: 100%;">
                    <label for="Image" class="form-label"><h4>Ảnh đại diện</h4></label>
                    <input type="file" class="form-control" id="Image" name="Image" accept="image/*" onchange="previewImage(event)" />
                </div>
                <div id="imagePreview" style="margin-top: 20px;">
                    <img src="@(Model.Image ?? "/img/default-avatar.png")" id="preview" alt="Avatar" 
                        class="img-fluid rounded-circle" style="width: 400px; height: 400px; object-fit: cover;" />
                </div>

            </div>
        </div>
    </form>
</div>

<!-- Script xem trước ảnh -->
<script>
    function previewImage(event) {
        const reader = new FileReader();
        reader.onload = function () {
            const preview = document.getElementById('preview');
            preview.src = reader.result;
        };
        reader.readAsDataURL(event.target.files[0]);
    }
</script>
