@{
    Layout = "_Layout";
}

@using HotelBooker.Models
@using Microsoft.AspNetCore.Identity

<div style="background-color: black; width: 100%; height: 150px;"></div>
<div class="container-xxl" style="padding-top: 50px; display: flex; gap: 20px; flex-direction: column;">
    <h2 class="text-center mb-4">Thông tin người dùng</h2>
    <div class="row">
        <div class="col-md-4 text-center">
            @if (string.IsNullOrEmpty(Model.Image))
            {
                <div class="mb-3">
                    <img src="https://via.placeholder.com/150" alt="Avatar" class="img-fluid rounded-circle" style="width: 170px; height: 170px; object-fit: cover;">
                    <p class="text-muted">Chưa có ảnh</p>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <img src="@Model.Image" alt="Avatar" class="img-fluid rounded-circle" style="width: 170px; height: 170px; object-fit: cover;" data-bs-toggle="modal" data-bs-target="#imageModal">
                    <p class="text-muted">Click để phóng to</p>
                </div>
            }
            <p><strong>Vai trò: </strong><span class="badge text-bg-info" style="color: #1E90FF; font-weight: bold;"><i class="fas fa-user-tag" style="color: #1E90FF;"></i> Admin</span></p>
            <p><strong>Tình trạng:</strong> <span class="badge bg-success text-white">Active</span></p>
        </div>
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div style="display: flex; width: 100%; flex-direction: row; align-items: center; justify-content: space-between;">
                        <h1>@Model.UserName </h1>
                        <div class="text-end">
                            <button class="btn btn-link" data-bs-toggle="dropdown" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="@Url.Action("Edit", "Account")">Thay đổi thông tin</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")">Logout</a></li>
                            </ul>
                        </div>
                    </div>
                    <p><strong>Email:</strong> <span style="color: #007BFF;"><i class="fas fa-envelope"></i> @Model.Email</span></p>
                    <div class="mt-4">
                        <h3 class="mb-3">Background Information</h3>
                        <p><strong>Gender:</strong> @if (string.IsNullOrEmpty(Model.Gender)) { <span class="text-muted">Please update</span> } else { @Model.Gender }</p>
                        <p><strong>Birthday:</strong> @if (Model.Birth == null) { <span class="text-muted">Please update</span> } else { @Model.Birth?.ToString("dd/MM/yyyy") }</p>
                        <p><strong>Phone number:</strong> @if (string.IsNullOrEmpty(Model.Phone)) { <span class="text-muted">Please update</span> } else { @Model.Phone }</p>
                        <p><strong>Address:</strong> @if (string.IsNullOrEmpty(Model.Address)) { <span class="text-muted">Please update</span> } else { @Model.Address }</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal để phóng to ảnh -->
@if (!string.IsNullOrEmpty(Model.Image))
{
    <div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="imageModalLabel">Ảnh người dùng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <img src="@Model.Image" alt="User Image" class="img-fluid" />
                </div>
            </div>
        </div>
    </div>
}
