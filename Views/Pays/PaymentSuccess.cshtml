@{
    ViewData["Title"] = "Payment Success";
}

<div style="background-color: black; width: 100%; height: 150px;"></div>
<div class="container-xxl text-center" style="padding-top: 50px; display: flex; justify-content: center;flex-direction: column; align-items: center;">
    <div id="successToast" class="toast align-items-center text-bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true" style="width: 70%; display: flex; justify-content: center;">
        <div class="d-flex">
            <div class="toast-body">
                <i class="fa fa-check-circle-o" aria-hidden="true" style="color: green; width: 100%; font-size: 300px;"></i>
                <h1> Payment Success!</h1>
                <p>Your payment was successfully processed. Thank you for your booking!</p>
            </div>
        </div>
    </div>
    <div style="margin-top: 20px;">
        <a asp-controller="User" asp-action="UserInfor" class="btn btn-primary">
            <i class="fas fa-arrow-left"></i> Back to My Information
        </a>
    </div>
</div>
