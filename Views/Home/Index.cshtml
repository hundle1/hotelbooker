@{
    ViewData["Title"] = "Home Page";
}

<div class="home">
    <div class="home__background">
        <img src="@Url.Content("~/img/bg_header.webp")" alt="">
    </div>
    <div class="grid wide">
        <div class="row">
            <div class="home__container__slider">
                <div class="home__container__slider--content"
                    style="align-items:center; display:flex; flex-direction:column;">
                    <h1 style="color: white;">HotelBooker</h1>
                    <h1>Khám phá thế giới</h1>
                </div>
                <div class="home__container__slider--btn">
                    <div class="btn__bgc"></div>
                    <a href="#">Trải nghiệm ngay 
                        <span></span>
                        <span></span>
                        <span></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="main-container">
    <!-- Tabs Section -->
    <div class="tabs">
        <div class="tab con-top-bottom active con-left" style="border-left: 1px solid #000;">Khách sạn</div>
        <div class="tab con-top-bottom">Thuê xe</div>
        <div class="tab con-top-bottom">Chuyến bay</div>
        <div class="tab con-top-bottom">Leo núi</div>
        <div class="tab con-top-bottom">Du thuyền</div>
        <div class="tab con-top-bottom active con-right">
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <span>
                    <a asp-controller="User" asp-action="UserInfor" style="font-weight: bold;">
                        <i class="fa fa-user"></i> Xin chào @User.Identity.Name
                    </a>
                </span>
            }
            else
            {
                <div>
                    <a asp-action="Login" asp-controller="User">Đăng nhập</a>
                    /
                    <a asp-action="SignUp" asp-controller="User">Đăng ký</a>
                </div>
            }
        </div>
    </div>

    <!-- Search Form Section -->
    <form id="hotel-form" onsubmit="return validateForm()" style="padding-top: 60px;">
        <div class="row">
            <div class="form-group destination">
                <label for="destination">Điểm đến</label>
                <input type="text" placeholder="Thành phố" class="form-control" id="destination" name="destination" required>
            </div>
        </div>

        <div class="row horizontal">
            <div class="form-group flex-grow-1">
                <label for="checkin-date">Ngày nhận</label>
                <input type="date" class="form-control" id="checkin-date" name="checkin-date" onkeydown="return false" required>
            </div>
            <div class="form-group flex-grow-1">
                <label for="checkout-date">Ngày trả</label>
                <input type="date" class="form-control" id="checkout-date" name="checkout-date" onkeydown="return false" required>
            </div>

            <div class="form-group">
                <label for="rooms">Số phòng</label>
                <select class="form-select" id="rooms">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                </select>
            </div>
            <div class="form-group">
                <label for="guests">Số khách</label>
                <select class="form-select" id="guests" onchange="javascript: dynamicDropdown(this.options[this.selectedIndex].value);">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="7">7</option>
                    <option value="8">8</option>
                    <option value="9">9</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col text-center">
                <button type="submit" class="btn btn-primary">Tìm khách sạn</button>
            </div>
            <div id="error" class="error text-danger"></div>
        </div>
    </form>
</div>

<div class="about_area" style="margin-top: 50px;">
    <div class="container">
        <div class="row">
            <div class="col-xl-5 col-lg-5">
                <div class="about_info">
                    <div class="section_title mb-30px">
                        <span>Về Chúng Tôi</span>
                        <h3>Khách sạn sang trọng <br>gần gũi thiên nhiên</h3>
                    </div>
                    <p>Chúng tôi cung cấp dịch vụ nghỉ dưỡng cao cấp kết hợp hài hòa với thiên nhiên, mang lại trải nghiệm thư giãn và đáng nhớ cho bạn.</p>
                    <a href="#" class="line-button">Tìm hiểu thêm</a>
                </div>
            </div>
            <div class="col-xl-7 col-lg-7">
                <div class="about_thumb d-flex">
                    <div class="img_1">
                        <img src="img/about/about_1.png" alt="">
                    </div>
                    <div class="img_2">
                        <img src="img/about/about_2.png" alt="">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="features_room">
    <div class="container" style="display:flex; justify-content: center;">
        <div class="row">
            <div class="col-xl-12">
                <div class="section_title text-center mb-100">
                    <span>Phòng nổi bật</span>
                    <h3>Chọn phòng tốt hơn</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="rooms_here">
        <div class="single_rooms">
            <div class="room_thumb">
                <img src="img/rooms/1.png" alt="">
                <div class="room_heading d-flex justify-content-between align-items-center">
                    <div class="room_heading_inner">
                        <span>Từ $250/đêm</span>
                        <h3>Phòng Superior</h3>
                    </div>
                    <a href="#" class="line-button">Đặt ngay</a>
                </div>
            </div>
        </div>
        <div class="single_rooms">
            <div class="room_thumb">
                <img src="img/rooms/2.png" alt="">
                <div class="room_heading d-flex justify-content-between align-items-center">
                    <div class="room_heading_inner">
                        <span>Từ $250/đêm</span>
                        <h3>Phòng Deluxe</h3>
                    </div>
                    <a href="#" class="line-button">Đặt ngay</a>
                </div>
            </div>
        </div>
        <div class="single_rooms">
            <div class="room_thumb">
                <img src="img/rooms/3.png" alt="">
                <div class="room_heading d-flex justify-content-between align-items-center">
                    <div class="room_heading_inner">
                        <span>Từ $250/đêm</span>
                        <h3>Phòng Signature</h3>
                    </div>
                    <a href="#" class="line-button">Đặt ngay</a>
                </div>
            </div>
        </div>
        <div class="single_rooms">
            <div class="room_thumb">
                <img src="img/rooms/4.png" alt="">
                <div class="room_heading d-flex justify-content-between align-items-center">
                    <div class="room_heading_inner">
                        <span>Từ $250/đêm</span>
                        <h3>Phòng đôi</h3>
                    </div>
                    <a href="#" class="line-button">Đặt ngay</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="package">
    <div class="package__background"></div>
    <div class="package__container">
        <div class="grid wide">
            <div class="package__container___body">
                <div class="package__container___body--content">
                    <div class="body--content__cta">
                        <h2>Gói nghỉ dưỡng Maldives cao cấp</h2>
                        <div class="item_rating">
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="far fa-star"></i>
                        </div>
                        <p>Một kỳ nghỉ đáng mơ ước giữa thiên nhiên tươi đẹp của Maldives, với các dịch vụ chuẩn quốc tế và trải nghiệm không thể nào quên.</p>
                    </div>
                    <div class="item--btn">
                        <div class="btn__bgc"></div>
                        <a href="#">Đặt ngay
                            <span></span>
                            <span></span>
                            <span></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
