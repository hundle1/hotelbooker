@{
    ViewData["Title"] = "Home Page";
}
<div class="home">
    <div class="home__background">
        <img src="@Url.Content("~/img/bg_header.webp")" alt="">
    </div>
    <div class="grid wide">
        <div class="row">
            <div class="home__container__slider">
                <div class="home__container__slider--content"
                    style="align-items:center; display:flex; flex-direction:column;">
                    <h1 style="color: white;">Discover</h1>
                    <h1>the world</h1>
                </div>
                <div class="home__container__slider--btn">
                    <div class="btn__bgc"></div>
                    <a href="#">explore now
                        <span></span>
                        <span></span>
                        <span></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="main-container">
        <!-- Tabs Section -->
        <div class="tabs">
            <div class="tab con-top-bottom active con-left" style="border-left: 1px solid #000;">Hotels</div>
            <div class="tab con-top-bottom">Car Rentals</div>
            <div class="tab con-top-bottom">Flights</div>
            <div class="tab con-top-bottom">Trips</div>
            <div class="tab con-top-bottom">Cruises</div>
            <div class="tab con-top-bottom active con-right">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <span>
                        <a asp-controller="User"  asp-action="UserInfor" style="font-weight: bold;">
                            <i class="fa fa-user"></i> Hello @User.Identity.Name
                        </a>
                        </span>
                }
                else
                {
                    <div>
                        <a asp-action="Login" asp-controller="User">Login</a>
                        /
                        <a asp-action="SignUp" asp-controller="User">Sign Up</a>
                    </div>
                }
            </div>
        </div>
        <!-- Search Form Section -->
        <form id="hotel-form" onsubmit="return validateForm()" style="padding-top: 60px;">
            <!-- Destination Section -->
            <div class="row">
                <div class="form-group destination">
                    <label for="destination">Destination</label>
                    <input type="text" placeholder="City" class="form-control" id="destination" name="destination" required>
                </div>
            </div>

            <!-- Check-in, Check-out, Rooms, Guests (Same Row) -->
            <div class="row horizontal">
                <div class="form-group">
                    <label for="checkin-date">Check-in</label>
                    <input type="date" class="form-control" id="checkin-date" name="checkin-date" onkeydown="return false" required>
                </div>
                <div class="form-group">
                    <label for="checkout-date">Check-out</label>
                    <input type="date" class="form-control" id="checkout-date" name="checkout-date" onkeydown="return false" required>
                </div>
                <div class="form-group">
                    <label for="rooms">Rooms</label>
                    <select class="form-select" id="rooms">
                        <option value="1">1</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="guests">Guests</label>
                    <select class="form-select" id="guests" onchange="javascript: dynamicDropdown(this.options[this.selectedIndex].value);">
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>
                        <option value="7">7</option>
                        <option value="8">8</option>
                        <option value="9">9</option>
                    </select>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="row">
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search hotels</button>
                </div>
                <div id="error" class="error text-danger"></div>
            </div>
        </form>
</div>

</div>
<div class="about_area">
    <div class="container">
        <div class="row">
            <div class="col-xl-5 col-lg-5">
                <div class="about_info">
                    <div class="section_title mb-20px">
                        <span>About Us</span>
                        <h3>A Luxuries Hotel <br>
                            with Nature</h3>
                    </div>
                    <p>Suscipit libero pretium nullam potenti. Interdum, blandit phasellus consectetuer dolor ornare
                        dapibus enim ut tincidunt rhoncus tellus sollicitudin pede nam maecenas, dolor sem. Neque
                        sollicitudin enim. Dapibus lorem feugiat facilisi faucibus et. Rhoncus.</p>
                    <a href="#" class="line-button">Learn More</a>
                </div>
            </div>
            <div class="col-xl-7 col-lg-7">
                <div class="about_thumb d-flex">
                    <div class="img_1">
                        <img src="img/about/about_1.png" alt="">
                    </div>
                    <div class="img_2">
                        <img src="img/about/about_2.png" alt="">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- about_area_end -->

<!-- features_room_startt -->
<div class="features_room">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="section_title text-center mb-100">
                    <span>Featured Rooms</span>
                    <h3>Choose a Better Room</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="rooms_here">
        <div class="single_rooms">
            <div class="room_thumb">
                <img src="img/rooms/1.png" alt="">
                <div class="room_heading d-flex justify-content-between align-items-center">
                    <div class="room_heading_inner">
                        <span>From $250/night</span>
                        <h3>Superior Room</h3>
                    </div>
                    <a href="#" class="line-button">book now</a>
                </div>
            </div>
        </div>
        <div class="single_rooms">
            <div class="room_thumb">
                <img src="img/rooms/2.png" alt="">
                <div class="room_heading d-flex justify-content-between align-items-center">
                    <div class="room_heading_inner">
                        <span>From $250/night</span>
                        <h3>Deluxe Room</h3>
                    </div>
                    <a href="#" class="line-button">book now</a>
                </div>
            </div>
        </div>
        <div class="single_rooms">
            <div class="room_thumb">
                <img src="img/rooms/3.png" alt="">
                <div class="room_heading d-flex justify-content-between align-items-center">
                    <div class="room_heading_inner">
                        <span>From $250/night</span>
                        <h3>Signature Room</h3>
                    </div>
                    <a href="#" class="line-button">book now</a>
                </div>
            </div>
        </div>
        <div class="single_rooms">
            <div class="room_thumb">
                <img src="img/rooms/4.png" alt="">
                <div class="room_heading d-flex justify-content-between align-items-center">
                    <div class="room_heading_inner">
                        <span>From $250/night</span>
                        <h3>Couple Room</h3>
                    </div>
                    <a href="#" class="line-button">book now</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- features_room_end -->
<div class="room-container">
    <div class="container">
        <div class="row">
            @foreach (var room in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card item-hov" style="width: 100%; height: 550px;">
                        <img src="@Url.Content("~/img/" + room.RoomImage)" class="card-img-top" alt="@room.RoomName"
                            style="height: 200px; object-fit: cover;">
                        <div class="card-body">
                            <h5 align="center" style="padding-top: 10px;">Status: @(room.Status ? "In Used" : "Available")
                            </h5>
                            <h4 class="card-title" style="font-family: sans-serif;">@room.RoomName</h4>
                            Price: @room.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))<br />
                            Category: @room.Services<br />
                            <p class="card-text">
                                <div class="furniture-list">
                                    @if (!string.IsNullOrEmpty(room.Furniture))
                                    {
                                        @foreach (var furniture in room.Furniture.Split(','))
                                        {
                                            <div class="furniture-item" style="font-family: sans-serif;">@furniture</div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="furniture-item" style="font-family: sans-serif; color: gray;">No furniture available</div>
                                    }
                                </div>
                            </p>
                        </div>
                        <div align="center" style="padding-bottom: 20px;">
                            <a href="/Book/Details/@room.Id" class="btn btn-primary">Read More</a>
                            <a href="#" class="btn btn-success">Book Now</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
