@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <div class="video-container">
        <video autoplay muted loop class="background-video vid-adjust ">
            <source src="~/media/bg-video.mp4" type="video/mp4">
            Your browser does not support the video tag.
        </video>
        <div class="content-overlay">
            <h1 class="display-4 pos-adjust">Welcome</h1>
        </div>
    </div>

    <div class="text-center" style="margin-top: 90px;">
        <div>
            <img src="~/img/wallpaper.jpeg" alt="Logo" style="height:400px; width:1500px" />
            <h1 class="display-4">Discover your new Taste</h1>
        </div>
        <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    </div>
</div>
