                    </div>
                    <a href="#" class="line-button">book now</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- features_room_end -->
<div class="room-container">
    <div class="container">
        <div class="row">
            @foreach (var room in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card item-hov" style="width: 100%; height: 550px;">
                        <img src="@Url.Content("~/img/" + room.RoomImage)" class="card-img-top" alt="@room.RoomName"
                            style="height: 200px; object-fit: cover;">
                        <div class="card-body">
                            <h5 align="center" style="padding-top: 10px;">Status: @(room.Status ? "In Used" : "Available")
                            </h5>
                            <h4 class="card-title" style="font-family: sans-serif;">@room.RoomName</h4>
                            Price: @room.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))<br />
                            Category: @room.Services<br />
                            <p class="card-text">
                                <div class="furniture-list">
                                    @if (!string.IsNullOrEmpty(room.Furniture))
                                    {
                                        @foreach (var furniture in room.Furniture.Split(','))
                                        {
                                            <div class="furniture-item" style="font-family: sans-serif;">@furniture</div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="furniture-item" style="font-family: sans-serif; color: gray;">No furniture available</div>
                                    }
                                </div>
                            </p>
                        </div>
                        <div align="center" style="padding-bottom: 20px;">
                            <a href="/Book/Details/@room.Id" class="btn btn-primary">Read More</a>
                            <a href="#" class="btn btn-success">Book Now</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
