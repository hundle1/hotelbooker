@{
    ViewData["Title"] = "Contact";
}
<div class="home">
    <div class="Contact__background">
        <a href="# ">
            <img src="~/img/Baibien1.jpg" alt>
        </a>
    </div>
    <div class="Contact__title">
        <h1>Contact</h1>
    </div>
</div>
<div class="Contact__Container">
    <div class="grid wide custom">
        <div class="Contact__Container">
            <div class="row">
                <div class="col l-12 m-12 c-12">
                    <div class="contact__container__form">
                        <div class="contact__container__form--title">
                            <h2>get in touch</h2>
                        </div>
                        <div class="contact__form">
                            <input type="text" placeholder="Name" class="contact_form_name">
                            <input type="text" placeholder="E-mail" class="contact_form_email">
                            <input type="text" placeholder="Subject" class="contact_form_subject">
                            <textarea name="" id="" cols="30" rows="10" placeholder="Message"></textarea>
                        </div>
                        <div class="row">
                            <div class="l-12 m-12 c-12 text-center">
                                <button class="form_submit_button">
                                    "send message"
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<div class="grid wide custom">
    <div class="contact__about">
        <div class="row">
            <div class="col l-5 m-5 c-12 img padding">
                    <img src="~/img/Dulich.png" alt="">
            </div>
            <div class="col l-4 m-4 c-12 padding">
                    <div class="contact__about--logo ">
                        <a href="# ">
                            <img src="~/img/logo.webp " alt=" "> Travelix
                        </a>
                    </div>
                    <p class="contact__about-text">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus quis vu lputate eros, iaculis consequat nisl. Nunc et suscipit urna. Integer eleme ntum orci eu vehicula iaculis consequat nisl. Nunc et suscipit urna pretium.</p>
                    <ul class="contact-item">
                        <li><a href="# "><i class="fab fa-pinterest "></i></a></li>
                        <li><a href="# "><i class="fab fa-facebook-f "></i></a></li>
                        <li><a href="# "><i class="fab fa-twitter "></i></a></li>
                        <li><a href="# "><i class="fab fa-dribbble "></i></a></li>
                        <li><a href="# "><i class="fab fa-behance "></i></a></li>
                    </ul>
            </div>
            <div class="col l-3 m-3 c-12 padding">
                    <div class="contact__container info">
                        <div class="contact__container__content ">
                            <div class="contact__container__info ">
                                <div class="contact__container__info--img ">
                                    <img src="~/img/Location.png" alt>
                                </div>
                                <span>82 Dịch Vọng Hậu, Cầu Giấy, Hà Nội</span>
                            </div>
                            <div class="contact__container__info ">
                                <div class="contact__container__info--img ">
                                    <img src="~/img/Email.png" alt>
                                </div>
                                <span>+84 945 507 000</span>
                            </div>
                            <div class="contact__container__info ">
                                <div class="contact__container__info--img ">
                                    <img src="~/img/Phone.png" alt>
                                </div>
                                <span>Khoa0255@gmail.com</span>
                            </div>
                            <div class="contact__container__info ">
                                <div class="contact__container__info--img ">
                                    <img src="~/img/Website.png" alt>
                                </div>
                                <span>www.newbiedev.com</span>
                            </div>
                        </div>
                    </div>
            </div>
        </div>
    </div>
</div>
</div>