<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>@ViewData["Title"] | HotelBooker</title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="img/favicon.png">
    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelBooker.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/font-awesome.min.css">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link href='https://cdn.jsdelivr.net/npm/froala-editor@latest/css/froala_editor.pkgd.min.css' rel='stylesheet' type='text/css'/>
</head>
<style>
    .sidebar {
        width: 260px;
        transition: width 0.3s ease-in-out;
        background-color: #4a5568; /* Lighter gray shade */
    }
    .sidebar.collapsed {
        width: 100px;
    }
    .main-body, footer {
        margin-left: 260px;
        max-width: calc(100% - 260px);
        transition: margin-left 0.3s ease-in-out, max-width 0.3s ease-in-out;
    }
    .sidebar-collapsed .main-body, .sidebar-collapsed footer {
        margin-left: 80px;
        max-width: calc(100% - 80px);
    }
    .nav-link {
        color: white !important; /* Ensure text stays white */
        text-decoration: none !important; /* Remove any underline */
        border: 1px solid transparent; /* Transparent border to maintain size */
        transition: all 0.2s ease-in-out;
    }
    .nav-link:hover {
        background-color: #2d3748 !important; /* Darker background on hover */
        border: 1px solid #a0aec0; /* Light gray border on hover */
        color: white !important; /* Keep text white on hover */
        text-decoration: none !important; /* Ensure no underline on hover */
    }
    .nav-link .tooltip-text {
        visibility: hidden;
        opacity: 0;
        position: absolute;
        left: 100%;
        margin-left: 8px;
        background-color: #2d3748;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        white-space: nowrap;
        transition: opacity 0.2s;
    }
    .nav-link:hover .tooltip-text {
        visibility: visible;
        opacity: 1;
    }
</style>
<body class="bg-gray-100">
    <header>
        <div id="sidebar" class="sidebar fixed top-0 left-0 h-screen text-white flex flex-col shadow-lg">
            <div class="flex items-center justify-between p-4 border-b border-gray-600">
                <span class="text-xl font-bold sidebar-text">HotelBooker</span>
                <button class="text-white focus:outline-none hover:none" onclick="toggleSidebar()">
                    <i class="fa fa-bars text-xl"></i>
                </button>
            </div>
            <nav class="flex-1 overflow-y-auto mt-4">
                <ul class="p-2">
                    <li class="nav-item mb-2">
                        <a class="nav-link flex items-center p-2 rounded-lg transition-colors" asp-area="Admin" asp-controller="Rooms" asp-action="Index">
                            <i class="fa fa-home mr-3 text-lg"></i>
                            <span class="sidebar-text whitespace-nowrap truncate text-white">Dash Board</span>
                            <span class="tooltip-text sidebar-collapsed:visible">Dash Board</span>
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link flex items-center p-2 rounded-lg transition-colors" asp-area="Admin" asp-controller="Hotels" asp-action="Index">
                            <i class="fa fa-image mr-3 text-lg"></i>
                            <span class="sidebar-text whitespace-nowrap truncate">Quản lý Hotels</span>
                            <span class="tooltip-text sidebar-collapsed:visible">Quản lý Hotels</span>
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link flex items-center p-2 rounded-lg transition-colors" asp-area="Admin" asp-controller="Rooms" asp-action="HotelRooms">
                            <i class="fa fa-book mr-3 text-lg"></i>
                            <span class="sidebar-text whitespace-nowrap truncate">Quản lý Rooms</span>
                            <span class="tooltip-text sidebar-collapsed:visible">Quản lý Rooms</span>
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link flex items-center p-2 rounded-lg transition-colors" asp-area="Admin" asp-controller="UserManage" asp-action="Index">
                            <i class="fa fa-user mr-3 text-lg"></i>
                            <span class="sidebar-text whitespace-nowrap truncate">Quản lý User</span>
                            <span class="tooltip-text sidebar-collapsed:visible">Quản lý User</span>
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link flex items-center p-2 rounded-lg transition-colors" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                            <i class="fa fa-newspaper-o mr-3 text-lg"></i>
                            <span class="sidebar-text whitespace-nowrap truncate">Đơn hàng</span>
                            <span class="tooltip-text sidebar-collapsed:visible">Đơn hàng</span>
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link flex items-center p-2 rounded-lg transition-colors" asp-area="" asp-controller="Home" asp-action="Privacy">
                            <i class="fa fa-lock mr-3 text-lg"></i>
                            <span class="sidebar-text whitespace-nowrap truncate">Privacy</span>
                            <span class="tooltip-text sidebar-collapsed:visible">Privacy</span>
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="p-4 border-t border-gray-600">
                <a class="nav-link flex items-center p-2 rounded-lg transition-colors" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa fa-arrow-left mr-3 text-lg"></i>
                    <span class="sidebar-text whitespace-nowrap ">Về Trang Chủ</span>
                    <span class="tooltip-text sidebar-collapsed:visible">Về Trang Chủ</span>
                </a>
            </div>
        </div>
    </header>
    <div class="main-body p-6">
        <main role="main">
            @RenderBody()
            @RenderSection("Scripts", required: false)
        </main>
    </div>
    <footer class="border-t footer text-muted bg-white p-4">
        <div class="container">
            © 2024 - HotelBooker - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src='https://cdn.jsdelivr.net/npm/froala-editor@latest/js/froala_editor.pkgd.min.js'></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            const body = document.body;
            sidebar.classList.toggle("collapsed");
            body.classList.toggle("sidebar-collapsed");
            
            const textElements = document.querySelectorAll(".sidebar-text");
            textElements.forEach(element => {
                element.style.display = sidebar.classList.contains("collapsed") ? "none" : "inline";
            });
        }

        window.onload = () => {
            const sidebar = document.getElementById("sidebar");
            sidebar.classList.add("active");
        };

        // Initialize Froala Editor
        var editor = new FroalaEditor('#editor-view');

        // Initialize datepickers
        $('#datepicker').datepicker({
            iconsLibrary: 'fontawesome',
            icons: { rightIcon: '<span class="fa fa-caret-down"></span>' }
        });
        $('#datepicker2').datepicker({
            iconsLibrary: 'fontawesome',
            icons: { rightIcon: '<span class="fa fa-caret-down"></span>' }
        });
    </script>
</body>
</html>