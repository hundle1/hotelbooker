<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>@ViewData["Title"] | HotelBooker</title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- <link rel="manifest" href="site.webmanifest"> -->
    <link rel="shortcut icon" type="image/x-icon" href="img/favicon.png">
    <!-- Place favicon.ico in the root directory -->
    <!-- CSS here -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelBooker.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/css/magnific-popup.css">
    <link rel="stylesheet" href="~/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/css/themify-icons.css">
    <link rel="stylesheet" href="~/css/nice-select.css">
    <link rel="stylesheet" href="~/css/flaticon.css">
    <link rel="stylesheet" href="~/css/gijgo.css">
    <link rel="stylesheet" href="~/css/animate.css">
    <link rel="stylesheet" href="~/css/slicknav.css">
    <link rel="stylesheet" href="~/css/style.css">
    <!-- <link rel="stylesheet" href="css/responsive.css"> -->
</head>
<style>
    .main-body,
    footer {
        margin-left: 250px;
        max-width: calc(100% - 250px);
        transition: margin-left 0.3s, max-width 0.3s;
    }
    body.sidebar-collapsed .main-body,
    body.sidebar-collapsed footer {
        margin-left: 100px;
        max-width: calc(100% - 80px);
        transition: margin-left 0.3s, max-width 0.3s;
    }
    #sidebar {
        width: 250px;
        transition: width 0.3s;
    }
    #sidebar.collapsed {
        width: 80px;
    }
</style>


<body>
    <header>
        <div id="sidebar" class="sidebar "
            style="display:flex; flex-wrap:wrap; justify-content:space-between; flex-direction:column;">
            <button class="close-btn" style="color: black;" onclick="toggleSidebar()"><i
                    class="fa fa-bars"></i></button>
            <nav style="margin-top: 70px;">
                <ul id="navigation">
                    <li class="nav-item">
                        <a class="nav-link active-admin" asp-area="Admin" asp-controller="Rooms" asp-action="Index">
                            <i style="margin-left: -5px;" class="fa fa-home"></i> <span class="text">Dash Board</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link " asp-area="" asp-controller="Home" asp-action="Index">
                            <i style="margin-left: -5px;" class="fa fa-image"></i> <span class="text">Gallery</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link " asp-area="Admin" asp-controller="Rooms" asp-action="HotelRooms">
                            <i style="margin-left: -3px;" class="fa fa-book"></i> <span class="text">Rooms</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link " asp-area="Admin" asp-controller="Rooms" asp-action="Discount">
                            <i style="margin-left: -6px;" class="fa fa-newspaper-o"></i> <span class="text">Discount</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link " asp-area="" asp-controller="Home" asp-action="Privacy">
                            <i style="margin-left: 0px;" class="fa fa-lock"></i> <span class="text">Privacy</span>
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="">
                <a class="nav-link back-home-hov" asp-area="" asp-controller="Home" asp-action="Index">
                    <i style="margin-left: 2px;" class="fa fa-arrow-left"> </i> <span class="text">Back to Home
                        (Travelix) </span>
                </a>
            </div>
        </div>

    </header>
    <div class="main-body" style="max-width: 100%;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted" style="position: relative; top: 422px;">
        <div class="container">
            &copy; 2024 - HotelBooker - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <!-- JS here -->
    <script src="js/vendor/modernizr-3.5.0.min.js"></script>
    <script src="js/vendor/jquery-1.12.4.min.js"></script>
    <script src="js/popper.min.js"></script>
    <script src="js/bootstrap.min.js"></script>
    <script src="js/owl.carousel.min.js"></script>
    <script src="js/isotope.pkgd.min.js"></script>
    <script src="js/ajax-form.js"></script>
    <script src="js/waypoints.min.js"></script>
    <script src="js/jquery.counterup.min.js"></script>
    <script src="js/imagesloaded.pkgd.min.js"></script>
    <script src="js/scrollIt.js"></script>
    <script src="js/jquery.scrollUp.min.js"></script>
    <script src="js/wow.min.js"></script>
    <script src="js/nice-select.min.js"></script>
    <script src="js/jquery.slicknav.min.js"></script>
    <script src="js/jquery.magnific-popup.min.js"></script>
    <script src="js/plugins.js"></script>
    <script src="js/gijgo.min.js"></script>
    <!--contact js-->
    <script src="js/contact.js"></script>
    <script src="js/jquery.ajaxchimp.min.js"></script>
    <script src="js/jquery.form.js"></script>
    <script src="js/jquery.validate.min.js"></script>
    <script src="js/mail-script.js"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            const body = document.body;
            sidebar.classList.toggle("collapsed");
            body.classList.toggle("sidebar-collapsed");
        }
    </script>


    <script src="js/main.js"></script>
    <script>
        $('#datepicker').datepicker({
            iconsLibrary: 'fontawesome',
            icons: {
                rightIcon: '<span class="fa fa-caret-down"></span>'
            }
        });
        $('#datepicker2').datepicker({
            iconsLibrary: 'fontawesome',
            icons: {
                rightIcon: '<span class="fa fa-caret-down"></span>'
            }

        });

        @* sidebar BarProp  *@
            function toggleSidebar() {
                const sidebar = document.getElementById("sidebar");
                const body = document.body;
                sidebar.classList.toggle("collapsed");
                body.classList.toggle("sidebar-collapsed");
            }

        window.onload = () => {
            const sidebar = document.getElementById("sidebar");
            sidebar.classList.add("active");
        };


    </script>

</body>

</html>
