@model HotelBooker.Models.Room

@{
    ViewData["Title"] = "Create";
}

<div class="container" style="padding-top: 150px; display: flex; gap: 20px; padding-top:50px; display:flex; flex-direction:column;">
    <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
        <a asp-action="Index" class="btn btn-dark">Quay lại danh sách <i class="fa fa-chevron-circle-left" style="color: red;"></i></a>
        <h1>Đăng tải thông tin phòng</h1>
        <div style="width:150px;"></div>
    </div>
    <div class="row">
        <div>
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <h4><label asp-for="RoomName" class="control-label"></label></h4>
                    <input asp-for="RoomName" class="form-control" placeholder="Tên phòng" />
                    <span asp-validation-for="RoomName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label class="control-label" asp-for="Status"></label></h4>
                    <div>
                        <button type="button" class="btn btn-primary toggle-status" data-value="false">
                            Còn trống
                        </button>
                        <input type="hidden" asp-for="Status" value="false" />
                    </div>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="ReleaseDate" class="control-label">Ngày bắt đầu sử dụng</label></h4>
                    <input asp-for="ReleaseDate" class="form-control" />
                    <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="Services" class="control-label">Dịch vụ đi kèm</label></h4>
                    <input asp-for="Services" class="form-control" />
                    <span asp-validation-for="Services" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="Price" class="control-label">Giá thuê</label></h4>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="RoomImage" class="control-label">Hình ảnh phòng</label></h4>
                    <div class="image-selection">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="RoomImage" id="room@i" value="room@i.jpg" @(i == 1 ? "checked" : "")>
                                <label class="form-check-label" for="room@i">
                                    <img src="@Url.Content($"~/img/room{i}.jpg")" alt="Phòng @i" class="img-thumbnail">
                                </label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="RoomImage" class="text-danger"></span>
                </div>

                <div class="form-group" style="margin-top: 60px;">
                    <h4><label asp-for="Furniture" class="control-label">Nội thất</label></h4>
                    <div class="d-flex flex-row justify-content-around warping" style="display:flex; flex-wrap:wrap;">
                        @{
                            string[] furnitures = { "Giường đơn", "Giường đôi", "Sofa", "Bàn tròn", "Ghế", "Tủ đồ", "Ban công", "Wifi", "Máy lạnh", "Đồ ăn nhẹ" };
                            string[] ids = { "First bed", "Second bed", "sofa", "Round table", "chairs", "wardrobe", "Balcony", "Wifi", "AC", "Snacks" };
                        }
                        @for (int i = 0; i < furnitures.Length; i++)
                        {
                            <div class="form-check form-warp">
                                <input class="form-check-input" type="checkbox" name="Furniture" id="@ids[i]" value="@furnitures[i]" />
                                <label class="form-check-label" for="@ids[i]">@furnitures[i]</label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="Furniture" class="text-danger"></span>
                </div>

                <div class="form-group" style="margin-top: 60px;">
                    <h4><label asp-for="Description" class="control-label">Mô tả chi tiết</label></h4>
                    <textarea id="editor-view" asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label class="control-label" asp-for="Discount">Khuyến mãi</label></h4>
                    <div>
                        <button type="button" class="btn btn-primary toggle-discount" data-value="false">
                            Không áp dụng
                        </button>
                        <input type="hidden" asp-for="Discount" value="false" />
                    </div>
                    <span asp-validation-for="Discount" class="text-danger"></span>
                </div>

                <div class="form-group discount-details">
                    <h4><label asp-for="DiscountStart" class="control-label">Ngày bắt đầu khuyến mãi</label></h4>
                    <input asp-for="DiscountStart" class="form-control" />
                    <span asp-validation-for="DiscountStart" class="text-danger"></span>
                </div>

                <div class="form-group discount-details">
                    <h4><label asp-for="DiscountEnd" class="control-label">Ngày kết thúc khuyến mãi</label></h4>
                    <input asp-for="DiscountEnd" class="form-control" />
                    <span asp-validation-for="DiscountEnd" class="text-danger"></span>
                </div>

                <div class="form-group discount-details">
                    <h4><label asp-for="DiscountPercent" class="control-label">Phần trăm giảm giá (%)</label></h4>
                    <input asp-for="DiscountPercent" class="form-control" />
                    <span asp-validation-for="DiscountPercent" class="text-danger"></span>
                </div>

                <div>
                    <input type="submit" value="Tạo phòng" class="btn btn-primary" style="margin-right: 30px; width: 130px;" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleButton = document.querySelector('.toggle-status');
            const hiddenInput = document.querySelector('input[name="Status"]');
            const releaseDateGroup = document.querySelector('input[name="ReleaseDate"]').closest('.form-group');

            function updateReleaseDateVisibility(isInUsed) {
                if (isInUsed) {
                    releaseDateGroup.style.display = '';
                } else {
                    releaseDateGroup.style.display = 'none';
                    document.querySelector('input[name="ReleaseDate"]').value = '';
                }
            }

            toggleButton.addEventListener('click', function () {
                const currentValue = toggleButton.getAttribute('data-value') === 'true';
                const newValue = !currentValue;
                toggleButton.setAttribute('data-value', newValue);
                toggleButton.textContent = newValue ? 'Đang sử dụng' : 'Còn trống';
                hiddenInput.value = newValue;

                updateReleaseDateVisibility(newValue);
            });

            const initialValue = hiddenInput.value === 'true';
            updateReleaseDateVisibility(initialValue);
        });

        document.addEventListener('DOMContentLoaded', function () {
            const discountToggleButton = document.querySelector('.toggle-discount');
            const discountHiddenInput = document.querySelector('input[name="Discount"]');
            const discountDetailsGroups = document.querySelectorAll('.discount-details');
            function updateDiscountDetailsVisibility(isApplyDiscount) {
                discountDetailsGroups.forEach(group => {
                    group.style.display = isApplyDiscount ? '' : 'none';
                });
                if (!isApplyDiscount) {
                    document.querySelector('input[name="DiscountStart"]').value = '';
                    document.querySelector('input[name="DiscountEnd"]').value = '';
                    document.querySelector('input[name="DiscountPercent"]').value = '';
                }
            }
            discountToggleButton.addEventListener('click', function () {
                const currentValue = discountToggleButton.getAttribute('data-value') === 'true';
                const newValue = !currentValue;
                discountToggleButton.setAttribute('data-value', newValue);
                discountToggleButton.textContent = newValue ? 'Áp dụng khuyến mãi' : 'Không áp dụng';
                discountHiddenInput.value = newValue;
                updateDiscountDetailsVisibility(newValue);
            });
            const initialDiscountValue = discountHiddenInput.value === 'true';
            updateDiscountDetailsVisibility(initialDiscountValue);
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
