@model HotelBooker.Models.Room

@{
    ViewData["Title"] = "Edit";
}

<div class="container" style="padding-top: 150px; display: flex; gap: 20px; padding-top:50px; display:flex; flex-direction:column;">
    <h1>Edit for @Model.RoomName</h1>
    <hr />
    <div class="row">
        <div>
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <h4><label asp-for="RoomName" class="control-label"></label></h4>
                    <input asp-for="RoomName" class="form-control" />
                    <span asp-validation-for="RoomName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <h4><label class="control-label" asp-for="Status"></label></h4>
                    <div>
                        <button type="button" class="btn btn-primary toggle-status" data-value="false">
                            Available
                        </button>
                        <input type="hidden" asp-for="Status" value="false" />
                    </div>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <h4><label asp-for="ReleaseDate" class="control-label"></label></h4>
                    <input asp-for="ReleaseDate" class="form-control" />
                    <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <h4><label asp-for="Services" class="control-label"></label></h4>
                    <input asp-for="Services" class="form-control" />
                    <span asp-validation-for="Services" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <h4><label asp-for="Price" class="control-label"></label></h4>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <h4><label asp-for="RoomImage" class="control-label"></label></h4>
                    <div class="image-selection">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="RoomImage" id="room1" value="room1.jpg"
                                checked>
                            <label class="form-check-label" for="room1">
                                <img src="@Url.Content("~/img/room1.jpg")" alt="Room 1" class="img-thumbnail">
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="RoomImage" id="room2" value="room2.jpg">
                            <label class="form-check-label" for="room2">
                                <img src="@Url.Content("~/img/room2.jpg")" alt="Room 2" class="img-thumbnail">
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="RoomImage" id="room3" value="room3.jpg">
                            <label class="form-check-label" for="room3">
                                <img src="@Url.Content("~/img/room3.jpg")" alt="Room 3" class="img-thumbnail">
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="RoomImage" id="room4" value="room4.jpg">
                            <label class="form-check-label" for="room4">
                                <img src="@Url.Content("~/img/room4.jpg")" alt="Room 4" class="img-thumbnail">
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="RoomImage" id="room5" value="room5.jpg">
                            <label class="form-check-label" for="room5">
                                <img src="@Url.Content("~/img/room5.jpg")" alt="Room 5" class="img-thumbnail">
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="RoomImage" class="text-danger"></span>
                </div>
                <div class="form-group" style="margin-top: 60px;">
                    <h4><label asp-for="Furniture" class="control-label"></label></h4>
                    <div class="d-flex flex-row justify-content-around warping" style="display:flex; flex-wrap:wrap;">
                        <div class="form-check form-warp">
                            <input class="form-check-input" type="checkbox" name="Furniture" id="First bed"
                                value="First Bed">
                            <label class="form-check-label" for="First bed">First Bed </label>
                        </div>
                        <div class="form-check form-warp">
                            <input class="form-check-input" type="checkbox" name="Furniture" id="Second bed"
                                value="Second Bed">
                            <label class="form-check-label" for="Second bed">Second Bed </label>
                        </div>
                        <div class="form-check form-warp">
                            <input class="form-check-input" type="checkbox" name="Furniture" id="sofa" value="Sofa">
                            <label class="form-check-label" for="sofa">Sofa</label>
                        </div>
                        <div class="form-check form-warp">
                            <input class="form-check-input" type="checkbox" name="Furniture" id="Round table"
                                value="Round Table">
                            <label class="form-check-label" for="Round table">Round Table</label>
                        </div>
                        <div class="form-check form-warp">
                            <input class="form-check-input" type="checkbox" name="Furniture" id="chairs" value="Chairs">
                            <label class="form-check-label" for="chairs">Chairs</label>
                        </div>
                        <div class="form-check form-warp">
                            <input class="form-check-input" type="checkbox" name="Furniture" id="wardrobe"
                                value="Wardrobe">
                            <label class="form-check-label" for="wardrobe">Wardrobe</label>
                        </div>
                        <div class="form-check form-warp">
                            <input class="form-check-input" type="checkbox" name="Furniture" id="Balcony"
                                value="Balcony">
                            <label class="form-check-label" for="Balcony">Balcony</label>
                        </div>
                        <div class="form-check form-warp">
                            <input class="form-check-input" type="checkbox" name="Furniture" id="Wifi" value="Wifi">
                            <label class="form-check-label" for="Wifi">Wifi</label>
                        </div>
                        <div class="form-check form-warp">
                            <input class="form-check-input" type="checkbox" name="Furniture" id="AC" value="AC">
                            <label class="form-check-label" for="AC">AC</label>
                        </div>
                        <div class="form-check form-warp">
                            <input class="form-check-input" type="checkbox" name="Furniture" id="Snacks" value="Snacks">
                            <label class="form-check-label" for="Snacks">Snacks</label>
                        </div>
                        
                    </div>
                    <span asp-validation-for="Furniture" class="text-danger"></span>
                </div>
                <div class="form-group" style="margin-top: 60px;">
                    <h4><label asp-for="Description" class="control-label"></label></h4>
                    <textarea id="editor-view" asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="form-group" style="margin-top: 20px;">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
    <div style="margin-top: 20px;">
        <a asp-action="Index" class="btn btn-dark">Back to List</a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleButton = document.querySelector('.toggle-status');
            const hiddenInput = document.querySelector('input[name="Status"]');
            const releaseDateGroup = document.querySelector('input[name="ReleaseDate"]').closest('.form-group');

            function updateReleaseDateVisibility(isInUsed) {
                if (isInUsed) {
                    releaseDateGroup.style.display = '';
                } else {
                    releaseDateGroup.style.display = 'none';
                    document.querySelector('input[name="ReleaseDate"]').value = '';
                }
            }

            toggleButton.addEventListener('click', function () {
                const currentValue = toggleButton.getAttribute('data-value') === 'true';
                const newValue = !currentValue;
                toggleButton.setAttribute('data-value', newValue);
                toggleButton.textContent = newValue ? 'In Used' : 'Available';
                hiddenInput.value = newValue;

                updateReleaseDateVisibility(newValue);
            });

            const initialValue = hiddenInput.value === 'true';
            updateReleaseDateVisibility(initialValue);
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
