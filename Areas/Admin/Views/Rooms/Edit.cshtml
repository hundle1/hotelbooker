@model HotelBooker.Models.Room

@{
    ViewData["Title"] = "Edit";
}


<div class="container" style="padding-top: 50px; display: flex; flex-direction: column; gap: 20px;">
    <h1>Chỉnh sửa thông tin phòng: @Model.RoomName</h1>
    <hr />
    <div class="row">
        <div>
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="form-group">
                    <h4><label asp-for="RoomName" class="control-label">Tên phòng</label></h4>
                    <input asp-for="RoomName" class="form-control" />
                    <span asp-validation-for="RoomName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="Status" class="control-label">Trạng thái</label></h4>
                    <div>
                        <button type="button" class="btn btn-primary toggle-status" data-value="false">Còn trống</button>
                        <input type="hidden" asp-for="Status" value="false" />
                    </div>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="ReleaseDate" class="control-label">Ngày trả phòng</label></h4>
                    <input asp-for="ReleaseDate" class="form-control" />
                    <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="Services" class="control-label">Dịch vụ</label></h4>
                    <input asp-for="Services" class="form-control" />
                    <span asp-validation-for="Services" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="Price" class="control-label">Giá phòng</label></h4>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="RoomImage" class="control-label">Hình ảnh phòng</label></h4>
                    <div class="image-selection">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="RoomImage" id="room@i" value="room@i.jpg" @(Model.RoomImage == $"room{i}.jpg" ? "checked" : "") />
                                <label class="form-check-label" for="room@i">
                                    <img src="@Url.Content($"~/img/room{i}.jpg")" alt="Phòng @i" class="img-thumbnail" />
                                </label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="RoomImage" class="text-danger"></span>
                </div>

                <div class="form-group" style="margin-top: 60px;">
                    <h4><label asp-for="Furniture" class="control-label">Nội thất</label></h4>
                    <div class="d-flex flex-row flex-wrap justify-content-around">
                        @{
                            var furnitureItems = new[] {
                                "Giường đơn", "Giường đôi", "Sofa", "Bàn tròn", "Ghế", "Tủ quần áo", "Ban công", "Wifi", "Máy lạnh", "Đồ ăn vặt"
                            };
                            foreach (var item in furnitureItems)
                            {
                                <div class="form-check m-2">
                                    <input class="form-check-input" type="checkbox" name="Furniture" id="@item" value="@item" />
                                    <label class="form-check-label" for="@item">@item</label>
                                </div>
                            }
                        }
                    </div>
                    <span asp-validation-for="Furniture" class="text-danger"></span>
                </div>

                <div class="form-group" style="margin-top: 60px;">
                    <h4><label asp-for="Description" class="control-label">Mô tả</label></h4>
                    <textarea id="editor-view" asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-dark">Quay lại danh sách</a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleButton = document.querySelector('.toggle-status');
            const hiddenInput = document.querySelector('input[name="Status"]');
            const releaseDateGroup = document.querySelector('input[name="ReleaseDate"]').closest('.form-group');

            function updateReleaseDateVisibility(isInUsed) {
                if (isInUsed) {
                    releaseDateGroup.style.display = '';
                } else {
                    releaseDateGroup.style.display = 'none';
                    document.querySelector('input[name="ReleaseDate"]').value = '';
                }
            }

            toggleButton.addEventListener('click', function () {
                const currentValue = toggleButton.getAttribute('data-value') === 'true';
                const newValue = !currentValue;
                toggleButton.setAttribute('data-value', newValue);
                toggleButton.textContent = newValue ? 'In Used' : 'Available';
                hiddenInput.value = newValue;

                updateReleaseDateVisibility(newValue);
            });

            const initialValue = hiddenInput.value === 'true';
            updateReleaseDateVisibility(initialValue);
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
