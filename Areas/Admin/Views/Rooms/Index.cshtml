@model IEnumerable<HotelBooker.Models.Room>

@{
    ViewData["Title"] = "Dashboard";
}
<!-- Container for Dashboard -->
<div class="container" style="padding-top: 50px; display: flex; gap: 20px; flex-direction: column; font-family: Arial, Helvetica, sans-serif; max-width: 100%;">

    <!-- Dashboard Title -->
    <h1 class="text-center" style="font-size: 36px; font-weight: bold;">
        @ViewData["Title"]
        <span style="font-size: 20px; font-weight: normal; color: #555;"></span>
    </h1>
    <p class="text-center" style="font-size: 20px; color: #555;">
        Đây là bảng điều khiển nơi bạn có thể theo dõi các thống kê và dữ liệu tổng quan của hệ thống đặt phòng khách sạn.
    </p>

    <!-- Row for Cards displaying statistics -->
    <div class="row" style="margin-bottom: 30px;">
        <!-- Total Revenue -->
        <div class="col-md-3" style="width: 430px;">
            <div class="card shadow-lg mb-4" style="border-radius: 15px; padding: 20px;">
                <div class="card-body">
                    <h5 class="card-title">Tổng Doanh Thu</h5>
                    <p class="card-text" style="font-size: 30px; color: #28a745;">$25,000</p>
                </div>
            </div>
        </div>

        <!-- User Accounts -->
        <div class="col-md-3" style="width: 430px;">
            <div class="card shadow-lg mb-4" style="border-radius: 15px; padding: 20px;">
                <div class="card-body">
                    <h5 class="card-title">Người Dùng</h5>
                    <p class="card-text" style="font-size: 30px; color: #007bff;">2</p>
                </div>
            </div>
        </div>

        <!-- Total Rooms -->
        <div class="col-md-3" style="width: 430px;">
            <div class="card shadow-lg mb-4" style="border-radius: 15px; padding: 20px;">
                <div class="card-body">
                    <h5 class="card-title">Tổng Số Phòng</h5>
                    <p class="card-text" style="font-size: 30px; color: #ffc107;">80</p>
                </div>
            </div>
        </div>

        <!-- Progress -->
        <div class="col-md-3" style="width: 430px;">
            <div class="card shadow-lg mb-4" style="border-radius: 15px; padding: 20px;">
                <div class="card-body">
                    <h5 class="card-title">Tỉ Lệ Đặt Phòng</h5>
                    <p class="card-text" style="font-size: 30px; color: #dc3545;">75%</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Row for Charts -->
    <div class="row">
        <!-- Revenue Trend Chart -->
        <div class="col-md-6" style="margin-bottom: 30px;">
            <div class="card shadow-lg mb-4" style="border-radius: 15px; padding: 20px;">
                <div class="card-body">
                    <h5 class="card-title">Biểu Đồ Doanh Thu Theo Tháng</h5>
                    <canvas id="revenueChart" style="height: 400px;"></canvas>
                </div>
            </div>
        </div>

        <!-- User Growth Chart -->
        <div class="col-md-6" style="margin-bottom: 30px;">
            <div class="card shadow-lg mb-4" style="border-radius: 15px; padding: 20px;">
                <div class="card-body">
                    <h5 class="card-title">Tăng Trưởng Người Dùng</h5>
                    <canvas id="userGrowthChart" style="height: 400px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Extra: Welcome and summary -->
    <div class="row mt-4">
        <div class="col-md-12 text-center">
            <div class="alert alert-info" style="font-size: 18px; border-radius: 10px;">
                👋 Chào mừng bạn quay trở lại hệ thống! Hãy tiếp tục theo dõi các chỉ số để cải thiện hoạt động kinh doanh khách sạn của bạn nhé!
            </div>
        </div>
    </div>

    <!-- Extra: Tips or next actions -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm" style="border-radius: 15px; padding: 25px; background-color: #f9f9f9;">
                <h5 class="mb-3" style="font-weight: bold;">📌 Gợi ý cho bạn:</h5>
                <ul style="font-size: 16px;">
                    <li>Xem lại các phòng chưa được đặt trong 30 ngày qua để chạy chương trình khuyến mãi.</li>
                    <li>Gửi email chào mừng tới người dùng mới để tăng mức độ gắn bó.</li>
                    <li>Xem thống kê đánh giá khách hàng để cải thiện chất lượng dịch vụ.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Add the necessary scripts for Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Revenue Trend Chart
    var ctx1 = document.getElementById('revenueChart').getContext('2d');
    var revenueChart = new Chart(ctx1, {
        type: 'line',
        data: {
            labels: ['Th1', 'Th2', 'Th3', 'Th4', 'Th5', 'Th6'],
            datasets: [{
                label: 'Doanh Thu',
                data: [5000, 7000, 8000, 6000, 10000, 9000],
                borderColor: 'rgba(75, 192, 192, 1)',
                borderWidth: 3,
                fill: false
            }]
        },
        options: {
            responsive: true,
            scales: {
                x: { ticks: { autoSkip: true, maxTicksLimit: 6 } },
                y: { beginAtZero: true }
            }
        }
    });

    // User Growth Chart
    var ctx2 = document.getElementById('userGrowthChart').getContext('2d');
    var userGrowthChart = new Chart(ctx2, {
        type: 'bar',
        data: {
            labels: ['Th1', 'Th2', 'Th3', 'Th4', 'Th5', 'Th6'],
            datasets: [{
                label: 'Người Dùng',
                data: [100, 150, 200, 300, 500, 650],
                backgroundColor: 'rgba(54, 162, 235, 0.5)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            scales: {
                x: { ticks: { autoSkip: true, maxTicksLimit: 6 } },
                y: { beginAtZero: true }
            }
        }
    });
</script>
