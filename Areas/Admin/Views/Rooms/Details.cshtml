@model HotelBooker.Models.Room

@{
    ViewData["Title"] = "Details";
}

<div class="bg-dark" style="width: 100%; height: 100px;"></div>
<div class="container-xxl" style="padding-top: 50px; display: flex; gap: 20px; flex-direction: column;">
    <!-- Room Image -->
    <div class="text-center mb-4">
        <img src="@Url.Content("~/img/" + Model.RoomImage)" class="img-fluid rounded shadow-lg" alt="@Model.RoomName" style="max-width: 100%; height: auto; object-fit: cover; border-radius: 10px;">
    </div>

    <!-- Room Details -->
    <div class="card shadow-sm">
        <div class="card-body">
            <h3 class="card-title text-center text-primary mb-4">@Model.RoomName</h3>
            <div class="row mb-3">
                <div class="col-md-6">
                    <p><strong>Status:</strong> 
                        <span class="badge @(Model.Status ? "bg-danger" : "bg-success")">
                            @(Model.Status ? "In Used" : "Available")
                        </span>
                    </p>
                    <p><strong>Release Date:</strong> 
                        @(Model.ReleaseDate.HasValue ? Model.ReleaseDate.Value.ToString("yyyy-MM-dd") : "None")
                    </p>
                    <p><strong>Price:</strong> 
                        @Model.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                    </p>
                </div>
                <div class="col-md-6">
                    <p><strong>Services:</strong> @Model.Services</p>
                    <p><strong>Furniture:</strong> 
                        @if (!string.IsNullOrEmpty(Model.Furniture))
                        {
                            @foreach (var item in Model.Furniture.Split(','))
                            {
                                <span class="badge bg-primary me-1">@item</span>
                            }
                        }
                        else
                        {
                            <span>None</span>
                        }
                    </p>
                    @if (Model.Discount)
                    {
                        <p class="text-danger"><strong>Discount:</strong> 
                            @Model.DiscountPercent% (from @Model.DiscountStart?.ToString("yyyy-MM-dd") to @Model.DiscountEnd?.ToString("yyyy-MM-dd"))
                        </p>
                    }
                    else
                    {
                        <p><strong>Discount:</strong> None</p>
                    }
                </div>
            </div>

            <!-- Description -->
            <div class="mb-4">
                <h5 class="text-primary">Description:</h5>
                <p>@Html.Raw(Model.Description?.Replace("\n", "<br>") ?? "No description available.")</p>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="mt-4 d-flex justify-content-between">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.Id">Edit</a>
        <a class="btn btn-secondary" asp-action="Index">Back to List</a>
    </div>
</div>
