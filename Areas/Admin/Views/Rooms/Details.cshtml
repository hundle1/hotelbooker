@model HotelBooker.Models.Room

@{
    ViewData["Title"] = "Details";
}

<div style="background-color: black; width: 100%; height: 100px;"></div>
<div class="container" style="padding-top: 150px; display: flex; gap: 20px; padding-top:50px; display:flex; flex-direction:column;">
    <h1>Details</h1>
    <div>
        <h4>Room</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.RoomName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.RoomName)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Status)
            </dt>
            <dd class="col-sm-10">
                @if(@Html.DisplayNameFor(model => model.Status) == "Available")
                {
                    <p>In Used</p>
                }
                else
                {
                    <p>Available</p>
                }
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </dt>
            <dd class="col-sm-10">
                @if(@Html.DisplayNameFor(model => model.Status) == "In Used")
                {
                    @Html.DisplayFor(model => model.ReleaseDate)
                }
                else
                {
                    <p>None</p>
                }
                
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Services)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Services)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Price)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Price)
            </dd>
        </dl>
    </div>
    <div>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.Id">Edit</a>
        <a asp-action="Index">Back to List</a>
    </div>

</div>
