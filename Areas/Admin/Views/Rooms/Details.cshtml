@model HotelBooker.Models.Room

@{
    ViewData["Title"] = "Details";
}

<div class="bg-dark" style="width: 100%; height: 100px;"></div>
<div class="container-xxl" style="padding-top: 50px; display: flex; gap: 20px; flex-direction: column;">
    <!-- Hình ảnh phòng -->
    <div class="text-center mb-4">
        <img src="@Url.Content("~/img/" + Model.RoomImage)" class="img-fluid rounded shadow-lg" alt="@Model.RoomName" style="max-width: 100%; height: auto; object-fit: cover; border-radius: 10px;">
    </div>

    <!-- Thông tin chi tiết -->
    <div class="card shadow-sm">
        <div class="card-body">
            <h3 class="card-title text-center text-primary mb-4">@Model.RoomName</h3>
            <div class="row mb-3">
                <div class="col-md-6">
                    <p><strong>Trạng thái:</strong> 
                        <span class="badge @(Model.Status ? "bg-danger" : "bg-success")">
                            @(Model.Status ? "Đang sử dụng" : "Còn trống")
                        </span>
                    </p>
                    <p><strong>Ngày trả phòng gần nhất:</strong> 
                        @(Model.ReleaseDate.HasValue ? Model.ReleaseDate.Value.ToString("dd/MM/yyyy") : "Không có")
                    </p>
                    <p><strong>Giá phòng:</strong> 
                        @Model.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))
                    </p>
                </div>
                <div class="col-md-6">
                    <p><strong>Dịch vụ đi kèm:</strong> @Model.Services</p>
                    <p><strong>Nội thất:</strong> 
                        @if (!string.IsNullOrEmpty(Model.Furniture))
                        {
                            @foreach (var item in Model.Furniture.Split(','))
                            {
                                <span class="badge bg-primary me-1">@item</span>
                            }
                        }
                        else
                        {
                            <span>Không có</span>
                        }
                    </p>
                    @if (Model.Discount)
                    {
                        <p class="text-danger"><strong>Khuyến mãi:</strong> 
                            @Model.DiscountPercent% (từ @Model.DiscountStart?.ToString("dd/MM/yyyy") đến @Model.DiscountEnd?.ToString("dd/MM/yyyy"))
                        </p>
                    }
                    else
                    {
                        <p><strong>Khuyến mãi:</strong> Không có</p>
                    }
                </div>
            </div>

            <!-- Mô tả -->
            <div class="mb-4">
                <h5 class="text-primary">Mô tả chi tiết:</h5>
                <p>@Html.Raw(Model.Description?.Replace("\n", "<br>") ?? "Không có mô tả.")</p>
            </div>
        </div>
    </div>

    <!-- Nút thao tác -->
    <div class="mt-4 d-flex justify-content-between">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.Id">Chỉnh sửa</a>
        <a class="btn btn-secondary" asp-action="Index">Quay lại danh sách</a>
    </div>
</div>
