@model IEnumerable<HotelBooker.Models.Hotel>

@{
    ViewData["Title"] = "Hotels";
}

<div class="container" style="padding-top: 50px; display: flex; flex-direction: column; gap: 20px;">
    <h1>📋 @ViewData["Title"]</h1>

    <!-- Liên kết điều hướng -->
    <div style="width: 100%; margin-bottom: 10px; display: flex; justify-content: space-between;">
        <a class="btn btn-info" style="color: white; text-decoration: none;" asp-area="" asp-controller="World"
            asp-action="Index">Xem trên trang chính</a>
        <a class="btn btn-success" style="color: white; text-decoration: none;" asp-action="Create"> Thêm khách sạn</a>
    </div>

    <!-- Thanh tìm kiếm -->
    <form method="get" action="@Url.Action("Index", "Hotels", new { area = "Admin" })"
        style="width: 100%; display: flex; justify-content: flex-start; gap: 20px;">
        <input type="text" name="searchString" placeholder="Tìm theo tên, đánh giá hoặc số phòng..."
            class="form-control" style="width: 80%; height: 50%; margin-top: 8px;" value="@ViewData["CurrentFilter"]" />
        <button type="submit" class="btn btn-primary mt-2">🔍 Tìm kiếm</button>
    </form>

    <!-- Bảng dữ liệu -->
    <table id="hotelTable" class="table table-striped table-hover"
        style="border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);">
        <thead class="thead-dark" style="background-color: #343a40; color: white;">
            <tr>
                <th scope="col" style="text-align: center;">
                    <a asp-action="Index" asp-route-sortOrder="name-asc"
                        asp-route-searchString="@ViewData["CurrentFilter"]"
                        style="text-decoration: none; color: white;">Tên khách sạn</a>
                    <a asp-action="Index" asp-route-sortOrder="name-desc"
                        asp-route-searchString="@ViewData["CurrentFilter"]"
                        style="text-decoration: none; color: white;">
                        <i class="fa fa-sort" style="color: white;"></i></a>
                </th>
                <th scope="col" style="text-align: center;">@Html.DisplayNameFor(model => model.First().HotelLocation)
                </th>
                <th scope="col" style="text-align: center;">
                    <a asp-action="Index" asp-route-sortOrder="rate-asc"
                        asp-route-searchString="@ViewData["CurrentFilter"]"
                        style="text-decoration: none; color: white;">Đánh giá</a>
                    <a asp-action="Index" asp-route-sortOrder="rate-desc"
                        asp-route-searchString="@ViewData["CurrentFilter"]"
                        style="text-decoration: none; color: white;">
                        <i class="fa fa-sort" style="color: white;"></i></a>
                </th>
                <th scope="col" style="text-align: center;">
                    <a asp-action="Index" asp-route-sortOrder="room-asc"
                        asp-route-searchString="@ViewData["CurrentFilter"]"
                        style="text-decoration: none; color: white;">Số phòng</a>
                    <a asp-action="Index" asp-route-sortOrder="room-desc"
                        asp-route-searchString="@ViewData["CurrentFilter"]"
                        style="text-decoration: none; color: white;">
                        <i class="fa fa-sort" style="color: white;"></i></a>
                </th>
                <th scope="col" style="text-align: center;">Hình ảnh</th>
                <th scope="col" style="text-align: center;">Thao tác</th>
            </tr>
        </thead>
        <tbody id="hotelTableBody">
            @foreach (var item in Model)
            {
                <tr>
                    <td
                        style="font-weight: bold; font-size: 16px; text-align: center; vertical-align: middle; width: 300px;">
                        @Html.DisplayFor(modelItem => item.HotelName)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        @Html.DisplayFor(modelItem => item.HotelLocation)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        @Html.DisplayFor(modelItem => item.HotelRate)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        @Html.DisplayFor(modelItem => item.NumberOfRoom)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        <img src="@Url.Content(item.HotelImage)" alt="@item.HotelName"
                            style="width: 80px; height: auto; border-radius: 8px; object-fit: cover;" />
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.Id">📝 Sửa</a>
                        <a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@item.Id">🔎 Chi tiết</a>
                        <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">🗑️ Xoá</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Phân trang -->
    <div id="pagination" class="pagination"
        style="display: flex; justify-content: center; gap: 10px; margin-top: 20px;">
        <!-- Pagination buttons will be generated by JavaScript -->
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tableBody = document.getElementById('hotelTableBody');
        const rows = Array.from(tableBody.getElementsByTagName('tr'));
        const itemsPerPage =7;
        let currentPage = 1;

        function displayPage(page) {
            const start = (page - 1) * itemsPerPage;
            const end = start + itemsPerPage;

            // Hide all rows
            rows.forEach(row => row.style.display = 'none');
            // Show only rows for the current page
            rows.slice(start, end).forEach(row => row.style.display = '');

            // Update pagination controls
            updatePagination(page);
        }

        function updatePagination(currentPage) {
            const totalPages = Math.ceil(rows.length / itemsPerPage);
            const pagination = document.getElementById('pagination');
            pagination.innerHTML = '';

            // First page button
            const firstBtn = document.createElement('button');
            firstBtn.innerHTML = '«';
            firstBtn.className = 'btn btn-outline-primary btn-sm';
            firstBtn.disabled = currentPage === 1;
            firstBtn.addEventListener('click', () => {
                currentPage = 1;
                displayPage(currentPage);
            });
            pagination.appendChild(firstBtn);

            // Previous page button
            const prevBtn = document.createElement('button');
            prevBtn.innerHTML = '««';
            prevBtn.className = 'btn btn-outline-primary btn-sm';
            prevBtn.disabled = currentPage === 1;
            prevBtn.addEventListener('click', () => {
                if (currentPage > 1) {
                    currentPage--;
                    displayPage(currentPage);
                }
            });
            pagination.appendChild(prevBtn);

            // Page numbers
            const maxPagesToShow = 4;
            let startPage = Math.max(1, currentPage - Math.floor(maxPagesToShow / 2));
            let endPage = Math.min(totalPages, startPage + maxPagesToShow - 1);

            if (endPage - startPage < maxPagesToShow - 1) {
                startPage = Math.max(1, endPage - maxPagesToShow + 1);
            }

            if (startPage > 1) {
                const ellipsisStart = document.createElement('span');
                ellipsisStart.innerHTML = '...';
                ellipsisStart.className = 'mx-2';
                pagination.appendChild(ellipsisStart);
            }

            for (let i = startPage; i <= endPage; i++) {
                const pageBtn = document.createElement('button');
                pageBtn.innerHTML = i;
                pageBtn.className = 'btn btn-sm ' + (i === currentPage ? 'btn-primary' : 'btn-outline-primary');
                pageBtn.addEventListener('click', () => {
                    currentPage = i;
                    displayPage(currentPage);
                });
                pagination.appendChild(pageBtn);
            }

            if (endPage < totalPages) {
                const ellipsisEnd = document.createElement('span');
                ellipsisEnd.innerHTML = '...';
                ellipsisEnd.className = 'mx-2';
                pagination.appendChild(ellipsisEnd);
            }

            // Next page button
            const nextBtn = document.createElement('button');
            nextBtn.innerHTML = '»»';
            nextBtn.className = 'btn btn-outline-primary btn-sm';
            nextBtn.disabled = currentPage === totalPages;
            nextBtn.addEventListener('click', () => {
                if (currentPage < totalPages) {
                    currentPage++;
                    displayPage(currentPage);
                }
            });
            pagination.appendChild(nextBtn);

            // Last page button
            const lastBtn = document.createElement('button');
            lastBtn.innerHTML = '»';
            lastBtn.className = 'btn btn-outline-primary btn-sm';
            lastBtn.disabled = currentPage === totalPages;
            lastBtn.addEventListener('click', () => {
                currentPage = totalPages;
                displayPage(currentPage);
            });
            pagination.appendChild(lastBtn);
        }

        // Initialize pagination
        if (rows.length > 0) {
            displayPage(currentPage);
        }
    });
</script>