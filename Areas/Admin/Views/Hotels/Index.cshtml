@model IEnumerable<HotelBooker.Models.Hotel>

@{
    ViewData["Title"] = "Hotels";
}

<div class="container" style="padding-top: 50px; display: flex; flex-direction: column; gap: 20px;">
    <h1>Hotels</h1>
    <!-- Sorting Links -->
    <div style="width: 100%; margin-bottom: 10px; display: flex; justify-content: space-between;">
        <a style="color: white; text-decoration: none;" class="btn btn-info" asp-area="" asp-controller="World"
            asp-action="Index">View In HomePage</a>
        <a style="color: white; text-decoration: none;" class="btn btn-success" asp-action="Create">Create New +</a>
    </div>

    <!-- Search Bar -->
    <form method="get" action="@Url.Action("Index", "Hotels", new { area = "Admin" })" style="width: 100%; display: flex; justify-content: flex-start; gap: 20px;">
        <input type="text" name="searchString" placeholder="Search by Name, Rate, or Room..." class="form-control" style="width: 80%; height: 50%; margin-top: 8px;"/>
        <button type="submit" class="btn btn-primary mt-2">Search</button>
    </form>
    
    <table class="table table-striped table-hover"
        style="border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);">
        <thead class="thead-dark" style="background-color: #343a40; color: white;">
            <tr>
                <th scope="col" style="text-align: center;">
                    <a asp-action="Index" asp-route-sortOrder="name-asc"
                        style="text-decoration: none; color: white;">Name</a>
                    <a asp-action="Index" asp-route-sortOrder="name-desc" style="text-decoration: none; color: white;">
                        <i class="fa fa-sort" style="color: white;"></i></a>
                </th>
                <th scope="col" style="text-align: center;">@Html.DisplayNameFor(model => model.First().HotelLocation)
                </th>
                <th scope="col" style="text-align: center;">
                    <a asp-action="Index" asp-route-sortOrder="rate-asc"
                        style="text-decoration: none; color: white;">Rate</a>
                    <a asp-action="Index" asp-route-sortOrder="rate-desc" style="text-decoration: none; color: white;">
                        <i class="fa fa-sort" style="color: white;"></i></a>
                </th>
                <th scope="col" style="text-align: center;">
                    <a asp-action="Index" asp-route-sortOrder="room-asc"
                        style="text-decoration: none; color: white;">Number of Rooms</a>
                    <a asp-action="Index" asp-route-sortOrder="room-desc" style="text-decoration: none; color: white;">
                        <i class="fa fa-sort" style="color: white;"></i></a>
                </th>
                <th scope="col" style="text-align: center;">@Html.DisplayNameFor(model => model.First().HotelImage)</th>
                <th scope="col" style="text-align: center;">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td
                        style="font-weight: bold; font-size: 16px; text-align: center; vertical-align: middle; width: 300px;">
                        @Html.DisplayFor(modelItem => item.HotelName)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        @Html.DisplayFor(modelItem => item.HotelLocation)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        @Html.DisplayFor(modelItem => item.HotelRate)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        @Html.DisplayFor(modelItem => item.NumberOfRoom)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        <img src="@Url.Content(item.HotelImage)" alt="@item.HotelName"
                            style="width: 80px; height: auto; border-radius: 8px; object-fit: cover;" />
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@item.Id">Details</a>
                        <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
