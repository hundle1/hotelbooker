@model IEnumerable<HotelBooker.Models.Hotel>

@{
    ViewData["Title"] = "Hotels";
}

<div class="container" style="padding-top: 50px; display: flex; flex-direction: column; gap: 20px;">
    <h1>📋 @ViewData["Title"]</h1>

    <!-- Liên kết điều hướng -->
    <div style="width: 100%; margin-bottom: 10px; display: flex; justify-content: space-between;">
        <a class="btn btn-info" style="color: white; text-decoration: none;"
           asp-area="" asp-controller="World" asp-action="Index">Xem trên trang chính</a>
        <a class="btn btn-success" style="color: white; text-decoration: none;"
           asp-action="Create"> Thêm khách sạn</a>
    </div>

    <!-- Thanh tìm kiếm -->
    <form method="get" action="@Url.Action("Index", "Hotels", new { area = "Admin" })"
          style="width: 100%; display: flex; justify-content: flex-start; gap: 20px;">
        <input type="text" name="searchString" placeholder="Tìm theo tên, đánh giá hoặc số phòng..."
               class="form-control" style="width: 80%; height: 50%; margin-top: 8px;" />
        <button type="submit" class="btn btn-primary mt-2">🔍 Tìm kiếm</button>
    </form>

    <!-- Bảng dữ liệu -->
    <table class="table table-striped table-hover"
           style="border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);">
        <thead class="thead-dark" style="background-color: #343a40; color: white;">
            <tr>
                <th scope="col" style="text-align: center;">
                    <a asp-action="Index" asp-route-sortOrder="name-asc"
                       style="text-decoration: none; color: white;">Tên khách sạn</a>
                    <a asp-action="Index" asp-route-sortOrder="name-desc"
                       style="text-decoration: none; color: white;">
                        <i class="fa fa-sort" style="color: white;"></i></a>
                </th>
                <th scope="col" style="text-align: center;">@Html.DisplayNameFor(model => model.First().HotelLocation)</th>
                <th scope="col" style="text-align: center;">
                    <a asp-action="Index" asp-route-sortOrder="rate-asc"
                       style="text-decoration: none; color: white;">Đánh giá</a>
                    <a asp-action="Index" asp-route-sortOrder="rate-desc"
                       style="text-decoration: none; color: white;">
                        <i class="fa fa-sort" style="color: white;"></i></a>
                </th>
                <th scope="col" style="text-align: center;">
                    <a asp-action="Index" asp-route-sortOrder="room-asc"
                       style="text-decoration: none; color: white;">Số phòng</a>
                    <a asp-action="Index" asp-route-sortOrder="room-desc"
                       style="text-decoration: none; color: white;">
                        <i class="fa fa-sort" style="color: white;"></i></a>
                </th>
                <th scope="col" style="text-align: center;">Hình ảnh</th>
                <th scope="col" style="text-align: center;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="font-weight: bold; font-size: 16px; text-align: center; vertical-align: middle; width: 300px;">
                        @Html.DisplayFor(modelItem => item.HotelName)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        @Html.DisplayFor(modelItem => item.HotelLocation)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        @Html.DisplayFor(modelItem => item.HotelRate)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        @Html.DisplayFor(modelItem => item.NumberOfRoom)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        <img src="@Url.Content(item.HotelImage)" alt="@item.HotelName"
                             style="width: 80px; height: auto; border-radius: 8px; object-fit: cover;" />
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.Id">📝 Sửa</a>
                        <a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@item.Id">🔎 Chi tiết</a>
                        <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">🗑️ Xoá</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
