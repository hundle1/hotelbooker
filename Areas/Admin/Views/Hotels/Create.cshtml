@model HotelBooker.Models.ViewModels.HotelRoomViewModel

@{
    ViewData["Title"] = "Create";
}

<div class="container"
     style="padding-top: 150px; display: flex; gap: 20px; padding-top:50px; display:flex; flex-direction:column;">
    <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
        <a asp-action="Index" class="btn btn-dark">Quay lại danh sách <i class="fa fa-chevron-circle-left"
                style="color: red;"></i></a>
        <h1>Thông tin khách sạn</h1>
        <div style="width:150px;"></div>
    </div>
    <div class="row" style="min-width: 100%; max-width: 100%;">
        <div>
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <h4><label asp-for="Hotel.HotelName" class="control-label">Tên khách sạn</label></h4>
                    <input asp-for="Hotel.HotelName" class="form-control" />
                    <span asp-validation-for="Hotel.HotelName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="Hotel.HotelImage" class="control-label">Ảnh khách sạn</label></h4>
                    <input asp-for="Hotel.HotelImage" class="form-control" type="text" placeholder="Nhập URL ảnh" />
                    <span asp-validation-for="Hotel.HotelImage" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="Hotel.HotelDescription" class="control-label">Mô tả khách sạn</label></h4>
                    <textarea id="editor-view" asp-for="Hotel.HotelDescription" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Hotel.HotelDescription" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="Hotel.HotelLocation" class="control-label">Khu vực</label></h4>
                    <select asp-for="Hotel.HotelLocation" class="form-control">
                        <option value="">-- Chọn châu lục --</option>
                        <option value="Asia">Châu Á</option>
                        <option value="Europe">Châu Âu</option>
                        <option value="Africa">Châu Phi</option>
                        <option value="Australia">Châu Úc</option>
                        <option value="America">Châu Mỹ</option>
                    </select>
                    <span asp-validation-for="Hotel.HotelLocation" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="Hotel.HotelRate" class="control-label">Đánh giá (sao)</label></h4>
                    <select asp-for="Hotel.HotelRate" class="form-control">
                        <option value="">-- Chọn số sao --</option>
                        <option value="1">1 sao</option>
                        <option value="2">2 sao</option>
                        <option value="3">3 sao</option>
                        <option value="4">4 sao</option>
                        <option value="5">5 sao</option>
                    </select>
                    <span asp-validation-for="Hotel.HotelRate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="Hotel.NumberOfRoom" class="control-label">Số phòng</label></h4>
                    <select id="roomDropdown" class="form-control" asp-for="Hotel.NumberOfRoom">
                        <option value="">-- Chọn số phòng --</option>
                        <option value="10">10</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="150">150</option>
                        <option value="200">200</option>
                        <option value="other">Khác</option>
                    </select>
                    <input id="customRoomInput" asp-for="Hotel.NumberOfRoom" class="form-control" type="number"
                        style="display: none; margin-top: 10px;" placeholder="Nhập số phòng khác" />
                    <span asp-validation-for="Hotel.NumberOfRoom" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="Hotel.HotelServices" class="control-label">Dịch vụ</label></h4>
                    <input asp-for="Hotel.HotelServices" class="form-control" />
                    <span asp-validation-for="Hotel.HotelServices" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="Hotel.HotelContact" class="control-label">Số điện thoại liên hệ</label></h4>
                    <input asp-for="Hotel.HotelContact" class="form-control" />
                    <span asp-validation-for="Hotel.HotelContact" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="Hotel.HotelEmail" class="control-label">Email</label></h4>
                    <input asp-for="Hotel.HotelEmail" class="form-control" type="email" />
                    <span asp-validation-for="Hotel.HotelEmail" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="Hotel.HotelWebsite" class="control-label">Website</label></h4>
                    <input asp-for="Hotel.HotelWebsite" class="form-control" type="url" />
                    <span asp-validation-for="Hotel.HotelWebsite" class="text-danger"></span>
                </div>

                <div>
                    <input type="submit" value="Thêm mới" class="btn btn-primary" style="margin-right: 30px; width: 130px;" />
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const roomDropdown = document.getElementById('roomDropdown');
        const customRoomInput = document.getElementById('customRoomInput');

        roomDropdown.addEventListener('change', function () {
            if (this.value === 'other') {
                customRoomInput.style.display = 'block';
                customRoomInput.setAttribute('name', 'NumberOfRoom');
            } else {
                customRoomInput.style.display = 'none';
                customRoomInput.removeAttribute('name');
            }
        });
    </script>
}
