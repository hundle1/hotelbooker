@model HotelBooker.Models.Hotel

@{
    ViewData["Title"] = "Edit";
}
<div style="background-color: black; width: 100%; height: 100px;"></div>
<div class="container"
    style="padding-top: 150px; display: flex; gap: 20px; padding-top:50px; display:flex; flex-direction:column;">
    <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
        <a asp-action="Index" class="btn btn-dark">Quay lại danh sách <i class="fa fa-chevron-circle-left"
                style="color: red;"></i></a>
        <h1>Chỉnh sửa thông tin khách sạn</h1>
        <div style="width:150px;"></div>
    </div>
    <div class="row" style="min-width: 100%; max-width: 100%;">
        <div>
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="form-group">
                    <h4><label asp-for="HotelName" class="control-label">Tên khách sạn</label></h4>
                    <input asp-for="HotelName" class="form-control" />
                    <span asp-validation-for="HotelName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="HotelImage" class="control-label">Hình ảnh</label></h4>
                    <input asp-for="HotelImage" class="form-control" type="text" placeholder="Nhập URL hình ảnh" />
                    <div style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
                        <img src="@Model.HotelImage" alt="Xem trước hình ảnh khách sạn" style="max-width: 60%; margin-top: 10px; border-radius: 10px;" />
                    </div>
                    <span asp-validation-for="HotelImage" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="HotelDescription" class="control-label">Mô tả</label></h4>
                    <textarea id="editor-view" asp-for="HotelDescription" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="HotelDescription" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="HotelLocation" class="control-label">Khu vực</label></h4>
                    <select asp-for="HotelLocation" class="form-control">
                        <option value="">-- Chọn châu lục --</option>
                        <option value="Asia">Châu Á</option>
                        <option value="Europe">Châu Âu</option>
                        <option value="Africa">Châu Phi</option>
                        <option value="Australia">Châu Úc</option>
                        <option value="America">Châu Mỹ</option>
                    </select>
                    <span asp-validation-for="HotelLocation" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="HotelRate" class="control-label">Đánh giá</label></h4>
                    <select asp-for="HotelRate" class="form-control">
                        <option value="">-- Chọn sao --</option>
                        <option value="1">1 sao</option>
                        <option value="2">2 sao</option>
                        <option value="3">3 sao</option>
                        <option value="4">4 sao</option>
                        <option value="5">5 sao</option>
                    </select>
                    <span asp-validation-for="HotelRate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="NumberOfRoom" class="control-label">Số phòng</label></h4>
                    <select id="roomDropdown" class="form-control" asp-for="NumberOfRoom">
                        <option value="">-- Chọn số lượng --</option>
                        <option value="10">10</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="150">150</option>
                        <option value="200">200</option>
                        <option value="other">Khác</option>
                    </select>
                    <input id="customRoomInput" asp-for="NumberOfRoom" class="form-control" type="number"
                        style="display: none; margin-top: 10px;" placeholder="Nhập số lượng tùy chọn" />
                    <span asp-validation-for="NumberOfRoom" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="HotelServices" class="control-label">Dịch vụ</label></h4>
                    <input asp-for="HotelServices" class="form-control" />
                    <span asp-validation-for="HotelServices" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="HotelContact" class="control-label">Số điện thoại liên hệ</label></h4>
                    <input asp-for="HotelContact" class="form-control" />
                    <span asp-validation-for="HotelContact" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="HotelEmail" class="control-label">Email</label></h4>
                    <input asp-for="HotelEmail" class="form-control" type="email" />
                    <span asp-validation-for="HotelEmail" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <h4><label asp-for="HotelWebsite" class="control-label">Website</label></h4>
                    <input asp-for="HotelWebsite" class="form-control" type="url" />
                    <span asp-validation-for="HotelWebsite" class="text-danger"></span>
                </div>

                <div>
                    <input type="submit" value="Lưu thay đổi" class="btn btn-primary"
                        style="margin-right: 30px; width: 130px;" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        const roomDropdown = document.getElementById('roomDropdown');
        const customRoomInput = document.getElementById('customRoomInput');

        roomDropdown.addEventListener('change', function () {
            if (this.value === 'other') {
                customRoomInput.style.display = 'block';
                customRoomInput.setAttribute('name', 'NumberOfRoom');
            } else {
                customRoomInput.style.display = 'none';
                customRoomInput.removeAttribute('name');
            }
        });
    </script>
}
