@model HotelBooker.Models.Hotel

@{
    ViewData["Title"] = "Delete";
}
<div style="background-color: black; width: 100%; height: 100px;"></div>
<div class="container"
    style="padding-top: 150px; display: flex; gap: 20px; padding-top:50px; display:flex; flex-direction:column;">
    <h1>Delete</h1>
    <h3>Are you sure you want to delete this?</h3>
    <div>
        <h4>Hotel</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.HotelName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.HotelName)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.HotelImage)
            </dt>
            <dd class="col-sm-10">
                <img src="@Model.HotelImage" alt="Hotel Image" style="max-width: 100px; max-height: 100px;" />
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.HotelDescription)
            </dt>
            <dd id="editor-view" class="col-sm-10">
                @Html.DisplayFor(model => model.HotelDescription)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.HotelLocation)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.HotelLocation)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.HotelRate)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.HotelRate)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.NumberOfRoom)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.NumberOfRoom)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.HotelServices)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.HotelServices)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.HotelContact)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.HotelContact)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.HotelEmail)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.HotelEmail)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.HotelWebsite)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.HotelWebsite)
            </dd>
        </dl>
        
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Index">Back to List</a>
        </form>
    </div>
</div>
