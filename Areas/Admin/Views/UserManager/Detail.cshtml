@model HotelBooker.Models.User

@{
    ViewData["Title"] = "User Detail";
}

<div class="container" style="padding-top: 150px; padding-top:50px;">
    <h1>@ViewData["Title"]</h1>
    <div class="row">
        <div class="col-md-4">
            <h4>Name: @Model.UserName</h4>
            <p>Email: @Model.Email</p>
            <p>Phone: @Model.Phone</p>
            <p>Role: @Model.Role</p>
            <p>Status: @Model.Status</p>
        </div>
        <div class="col-md-4">
            <a href="@Url.Action("Index", "UserManager")" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
