@model IEnumerable<HotelBooker.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<div class="container" style="padding-top: 50px; display: flex; flex-direction: column; gap: 20px;">
    <h1>📋 @ViewData["Title"]</h1>

    <!-- Liên kết điều hướng -->
    <div style="width: 100%; margin-bottom: 10px; display: flex; justify-content: space-between;">
        <a class="btn btn-info" style="color: white; text-decoration: none;"
           asp-area="" asp-controller="World" asp-action="Index">Xem trên trang chính</a>
    </div>

    <!-- Thanh tìm kiếm -->
    <form method="get" action="@Url.Action("Index", "Orders", new { area = "Admin" })"
          style="width: 100%; display: flex; justify-content: flex-start; gap: 20px;">
        <input type="text" name="searchString" placeholder="Tìm theo tên khách sạn, phòng, người dùng hoặc giá..."
               class="form-control" style="width: 80%; height: 50%; margin-top: 8px;" />
        <button type="submit" class="btn btn-primary mt-2">🔍 Tìm kiếm</button>
    </form>

    <!-- Bảng dữ liệu -->
    <table class="table table-striped table-hover"
           style="border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);">
        <thead class="thead-dark" style="background-color: #343a40; color: white;">
            <tr>
                <th scope="col" style="text-align: center;">
                    <a asp-action="Index" asp-route-sortOrder="date-asc"
                       style="text-decoration: none; color: white;">Ngày đặt</a>
                    <a asp-action="Index" asp-route-sortOrder="date-desc"
                       style="text-decoration: none; color: white;">
                        <i class="fa fa-sort" style="color: white;"></i></a>
                </th>
                <th scope="col" style="text-align: center;">Khách sạn</th>
                <th scope="col" style="text-align: center;">Số phòng</th>
                <th scope="col" style="text-align: center;">
                    <a asp-action="Index" asp-route-sortOrder="price-asc"
                       style="text-decoration: none; color: white;">Tổng giá</a>
                    <a asp-action="Index" asp-route-sortOrder="price-desc"
                       style="text-decoration: none; color: white;">
                        <i class="fa fa-sort" style="color: white;"></i></a>
                </th>
                <th scope="col" style="text-align: center;">Trạng thái</th>
                <th scope="col" style="text-align: center;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="font-weight: bold; font-size: 16px; text-align: center; vertical-align: middle; width: 200px;">
                        @item.BookingDate.ToString("dd/MM/yyyy")
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        @Html.DisplayFor(modelItem => item.Hotel.HotelName)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        @Html.DisplayFor(modelItem => item.RoomNumber)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        @item.TotalPrice.ToString("N0") VND
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        @(item.Status ? "Hoàn thành" : "Chưa hoàn thành")
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        <a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@item.Id">🔎 Chi tiết</a>
                        <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">🗑️ Xoá</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>