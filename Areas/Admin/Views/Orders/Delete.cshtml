@model HotelBooker.Models.Order

@{
    ViewData["Title"] = "Delete";
}

<div class="container-xxl" style="padding-top: 50px; display: flex; flex-direction: column; gap: 20px;">
    <h1>Xóa Bỏ Đơn Hàng</h1>
    <h3>Bạn thực sự muốn xóa đơn hàng này?</h3>
    <div>
        <h4>Order : @Model.Hotel?.HotelName - @Model.RoomNumber</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                Ngày đặt
            </dt>
            <dd class="col-sm-10">
                @Model.BookingDate.ToString("dd/MM/yyyy")
            </dd>

            <dt class="col-sm-2">
                Người dùng
            </dt>
            <dd class="col-sm-10">
                @Model.User?.UserName
            </dd>

            <dt class="col-sm-2">
                Tổng giá
            </dt>
            <dd class="col-sm-10">
                @Model.TotalPrice.ToString("N0") VND
            </dd>

            <dt class="col-sm-2">
                Trạng thái
            </dt>
            <dd class="col-sm-10">
                @(Model.Status ? "Hoàn thành" : "Chưa hoàn thành")
            </dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Index">Back to List</a>
        </form>
    </div>
</div>