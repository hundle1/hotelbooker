@model HotelBooker.Models.User

@{
    ViewData["Title"] = "Delete User";
}

<div class="container" style="padding-top: 150px;">
    <h2 class="text-center">Confirm Delete</h2>

    <div class="alert alert-danger" style="max-width: 600px; margin: 0 auto;">
        <p><strong>Warning:</strong> Are you sure you want to delete the account for <strong>@Model.UserName</strong>?</p>
    </div>

    <form method="post" style="max-width: 600px; margin: 0 auto;">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="form-group">
            <button type="submit" class="btn btn-danger btn-block">Yes, Delete</button>
            <a href="@Url.Action("Index", "UserManage", new { area = "Admin" })" class="btn btn-secondary btn-block">Cancel</a>
        </div>
    </form>
</div>
