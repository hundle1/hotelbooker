@using Azure.Core
@using HotelBooker.Models
@model IEnumerable<User>

<div class="container" style="padding-top: 150px; display: flex; gap: 20px; flex-direction: column;">
    <h2 class="text-center" style="font-size: 2rem; font-weight: bold;">User Management</h2>
    
    <!-- Thanh tìm kiếm -->
    <form method="get" style="margin-bottom: 20px; display: flex; justify-content: space-between; width: 100%; max-width: 600px;">
        <input type="text" name="searchString" value="@Context.Request.Query["searchString"]"
            class="form-control" placeholder="Search by username or email"
            style="height: 40px; font-size: 16px;" />
        <input type="submit" value="Search" class="btn btn-primary" 
            style="height: 40px; font-size: 16px; margin-left: 10px;" />
    </form>

    <!-- Bảng người dùng -->
    <table class="table table-striped table-hover"
        style="border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);">
        <thead class="thead-dark" style="background-color: #343a40; color: white;">
            <tr>
                <th scope="col" style="text-align: center;">#</th>
                <th scope="col" style="text-align: center;">Image</th>
                <th scope="col" style="text-align: center;">
                    <a asp-controller="UserManage" asp-action="Index" asp-route-sortOrder="name-asc"
                    style="text-decoration: none; color: white; padding: 0 5px;">
                        Username
                    </a>
                    <a asp-controller="UserManage" asp-action="Index" asp-route-sortOrder="name-desc"
                    style="text-decoration: none; color: white; padding: 0 5px;">
                        <i class="fa fa-sort" style="color: white;"></i>
                    </a>
                </th>
                <th scope="col" style="text-align: center;">Email</th>
                <th scope="col" style="text-align: center;">
                    <a asp-controller="UserManage" asp-action="Index" asp-route-sortOrder="phone-asc"
                    style="text-decoration: none; color: white; padding: 0 5px;">
                        Phone Number
                    </a>
                    <a asp-controller="UserManage" asp-action="Index" asp-route-sortOrder="phone-desc"
                    style="text-decoration: none; color: white; padding: 0 5px;">
                        <i class="fa fa-sort" style="color: white;"></i>
                    </a>
                </th>
                <th scope="col" style="text-align: center;">Birth Date</th>
                <th scope="col" style="text-align: center;">Role</th>
                <th scope="col" style="text-align: center;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 1;
                foreach (var user in Model)
                {
                    <tr>
                        <td style="font-weight: bold; font-size: 16px; text-align: center; vertical-align: middle; width: 50px;">
                            @index
                        </td>
                        <td style="text-align: center; vertical-align: middle;">
                            <img src="@user.ImageURL" alt="User Image" 
                                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 50%;" />
                        </td>
                        <td style="text-align: center; vertical-align: middle;">
                            @user.UserName
                        </td>
                        <td style="text-align: center; vertical-align: middle;">
                            @user.Email
                        </td>
                        <td style="text-align: center; vertical-align: middle;">
                            @user.PhoneNumber
                        </td>
                        <td style="text-align: center; vertical-align: middle;">
                            @user.Birth?.ToString("yyyy-MM-dd")
                        </td>
                        <td style="text-align: center; vertical-align: middle;">
                            @if (ViewBag.UserRoles is Dictionary<string, List<string>> userRoles && userRoles.ContainsKey(user.Id))
                            {
                                foreach (var role in userRoles[user.Id])
                                {
                                    <span class="badge badge-primary" style="background-color: #007bff; color: white; padding: 5px 10px; margin-right: 5px;">
                                        @role
                                    </span>
                                }
                            }
                        </td>
                        <td style="text-align: center; vertical-align: middle;">
                            <a href="@Url.Action("Details", "UserManage", new { area = "Admin", id = user.Id })" class="btn btn-primary btn-sm" 
                               style="font-size: 14px; padding: 8px 16px; margin-right: 5px;">Details</a>
                            <a href="@Url.Action("Edit", "UserManage", new { area = "Admin", id = user.Id })" class="btn btn-warning btn-sm" 
                               style="font-size: 14px; padding: 8px 16px; margin-right: 5px;">Edit</a>
                            @if (User.Identity != null && user.UserName != User.Identity.Name) {
                                <a href="@Url.Action("Delete", "UserManage", new { area = "Admin", id = user.Id })" class="btn btn-danger btn-sm" 
                                   style="font-size: 14px; padding: 8px 16px;">Delete</a>
                            }
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">No users found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
